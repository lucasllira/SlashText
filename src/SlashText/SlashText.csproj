<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SlashDesk.ico</ApplicationIcon>
    <AssemblyName>SlashDesk</AssemblyName>
    <RootNamespace>SlashText</RootNamespace>
    <Version>3.3.0</Version>
    <AssemblyVersion>3.3.0.0</AssemblyVersion>
    <FileVersion>3.3.0.0</FileVersion>
    <SlashDeskMinimumRuntimeVersion>10.0.13</SlashDeskMinimumRuntimeVersion>
    <DebugType>embedded</DebugType>
    <CapturePilotBuild Condition="'$(CaptureComplementsPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(CaptureOcrPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(ShortcutsPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(QuickAccentPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(StatisticsPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(SettingsPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(AboutPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(AuxiliaryPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(LanguagesPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(BackupCompatibilityPilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(ProtectedStoragePilotBuild)' == 'true'">true</CapturePilotBuild>
    <CapturePilotBuild Condition="'$(LegacyBackupsPilotBuild)' == 'true'">true</CapturePilotBuild>
    <SlashDeskDistribution Condition="'$(SlashDeskDistribution)' == ''">Installed</SlashDeskDistribution>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SlashDeskLegacyBackupsPilot" Value="true" Condition="'$(LegacyBackupsPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskProtectedStoragePilot" Value="true" Condition="'$(ProtectedStoragePilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskBackupCompatibilityPilot" Value="true" Condition="'$(BackupCompatibilityPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskLanguagesPilot" Value="true" Condition="'$(LanguagesPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskAboutPilot" Value="true" Condition="'$(AboutPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskAuxiliaryPilot" Value="true" Condition="'$(AuxiliaryPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskDistribution" Value="$(SlashDeskDistribution)" />
    <AssemblyMetadata Include="SlashDeskCaptureComplementsPilot" Value="true" Condition="'$(CaptureComplementsPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskShortcutsPilot" Value="true" Condition="'$(ShortcutsPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskQuickAccentPilot" Value="true" Condition="'$(QuickAccentPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskStatisticsPilot" Value="true" Condition="'$(StatisticsPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskSettingsPilot" Value="true" Condition="'$(SettingsPilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskCapturePilot" Value="true" Condition="'$(CapturePilotBuild)' == 'true'" />
    <AssemblyMetadata Include="SlashDeskCaptureOcrPilot" Value="true" Condition="'$(CaptureOcrPilotBuild)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SlashDesk.ico" />
    <EmbeddedResource Include="Assets\Lucide\LICENSE.txt" />
    <EmbeddedResource Include="Localization\*.json" />
    <EmbeddedResource Include="Assets\AvalonEdit\LICENSE.txt" />
    <Resource Include="Assets\SlashDesk.png" />
    <EmbeddedResource Include="Assets\NotoEmoji\*.png" />
    <EmbeddedResource Include="Assets\NotoEmoji\catalog.json" LogicalName="SlashText.Assets.NotoEmoji.catalog.json" />
    <EmbeddedResource Include="Assets\NotoEmoji\catalog-assets.zip" LogicalName="SlashText.Assets.NotoEmoji.catalog-assets.zip" />
    <EmbeddedResource Include="Assets\NotoEmoji\LICENSE.txt" />
    <EmbeddedResource Include="Assets\NotoEmoji\UNICODE-LICENSE.txt" />
    <EmbeddedResource Include="Assets\NotoEmoji\FLAGS-LICENSE.txt" />
    <EmbeddedResource Include="Assets\NotoEmoji\NOTICE.md" />
    <None Update="Assets\NotoEmoji\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\NotoEmoji\NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\snippets.md"
                      Link="Defaults\snippets.md"
                      LogicalName="SlashText.Defaults.snippets.md" />
  </ItemGroup>
  <Target Name="ValidateRuntimeServicing" AfterTargets="ResolveFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_SlashDeskRuntimePack Include="@(ResolvedRuntimePack)"
        Condition="'%(ResolvedRuntimePack.NuGetPackageId)' == 'Microsoft.NETCore.App.Runtime.win-x64' Or '%(ResolvedRuntimePack.NuGetPackageId)' == 'Microsoft.WindowsDesktop.App.Runtime.win-x64'" />
    </ItemGroup>
    <Error Condition="'@(_SlashDeskRuntimePack)' == ''" Text="Self-contained build requires resolved Windows x64 runtime packs." />
    <Error Condition="$([MSBuild]::VersionLessThan('%(_SlashDeskRuntimePack.NuGetPackageVersion)', '$(SlashDeskMinimumRuntimeVersion)'))"
      Text="Runtime %(_SlashDeskRuntimePack.NuGetPackageId)/%(_SlashDeskRuntimePack.NuGetPackageVersion) is below the reviewed minimum $(SlashDeskMinimumRuntimeVersion). Restore with a compatible SDK and current servicing; do not downgrade the runtime." />
  </Target>
  <Target Name="RestoreNotoEmoji" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\restore-noto-emoji.ps1&quot;" />
  </Target>
  <Target Name="GenerateThirdPartyNotices" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveFrameworkReferences">
    <PropertyGroup>
      <ThirdPartyOutput>$(IntermediateOutputPath)third-party\</ThirdPartyOutput>
    </PropertyGroup>
    <MakeDir Directories="$(ThirdPartyOutput)" />
    <WriteLinesToFile File="$(ThirdPartyOutput)runtime-packs.txt" Lines="@(ResolvedRuntimePack->'%(NuGetPackageId)|%(NuGetPackageVersion)|%(PackageDirectory)')" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\generate-third-party-notices.ps1&quot; -AssetsFile &quot;$(ProjectAssetsFile)&quot; -RuntimePacksFile &quot;$(ThirdPartyOutput)runtime-packs.txt&quot; -OutputDirectory &quot;$(ThirdPartyOutput).&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(ThirdPartyOutput)catalog.json" LogicalName="SlashText.ThirdParty.catalog.json" />
      <EmbeddedResource Include="$(ThirdPartyOutput)notices.zip" LogicalName="SlashText.ThirdParty.notices.zip" />
    </ItemGroup>
  </Target>
  <Target Name="RestoreOcrModels" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\restore-ocr-models.ps1&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="Assets\Ocr\**\*.traineddata" />
      <EmbeddedResource Include="Assets\Ocr\NOTICE.md;Assets\Ocr\LICENSE.txt" />
    </ItemGroup>
  </Target>
</Project>
