<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SlashDesk.ico</ApplicationIcon>
    <AssemblyName>SlashDesk</AssemblyName>
    <RootNamespace>SlashText</RootNamespace>
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <DebugType>embedded</DebugType>
    <SlashDeskDistribution Condition="'$(SlashDeskDistribution)' == ''">Installed</SlashDeskDistribution>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SlashDeskDistribution" Value="$(SlashDeskDistribution)" />
    <AssemblyMetadata Include="SlashDeskCapturePilot" Value="true" Condition="'$(CapturePilotBuild)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SlashDesk.ico" />
    <EmbeddedResource Include="Assets\Lucide\LICENSE.txt" />
    <Resource Include="Assets\SlashDesk.png" />
    <EmbeddedResource Include="Assets\NotoEmoji\*.png" />
    <EmbeddedResource Include="Assets\NotoEmoji\catalog.json" LogicalName="SlashText.Assets.NotoEmoji.catalog.json" />
    <EmbeddedResource Include="Assets\NotoEmoji\LICENSE.txt" />
    <EmbeddedResource Include="Assets\NotoEmoji\UNICODE-LICENSE.txt" />
    <EmbeddedResource Include="Assets\NotoEmoji\FLAGS-LICENSE.txt" />
    <EmbeddedResource Include="Assets\NotoEmoji\NOTICE.md" />
    <None Update="Assets\NotoEmoji\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\NotoEmoji\NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\snippets.md"
                      Link="Defaults\snippets.md"
                      LogicalName="SlashText.Defaults.snippets.md" />
  </ItemGroup>
  <Target Name="RestoreNotoEmoji" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\restore-noto-emoji.ps1&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="Assets\NotoEmoji\Full\*.png">
        <LogicalName>SlashText.Assets.NotoEmoji.Full.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
