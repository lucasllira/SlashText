<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lab="clr-namespace:SlashText.Design">
    <!-- Approved compact rows. All styles are scoped to Quick Accent. -->
    <Geometry x:Key="Lab.Icon.Zap">M13,2 L5,14 L11,14 L9,22 L19,9 L13,9 Z</Geometry>
    <Style x:Key="Lab.Accent.Choice" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="MinWidth" Value="48"/><Setter Property="MinHeight" Value="44"/>
        <Setter Property="Margin" Value="0,0,6,6"/><Setter Property="FontSize" Value="23"/>
        <Setter Property="Padding" Value="9,6"/>

    </Style>
    <Style x:Key="Lab.Accent.Card" TargetType="Border" BasedOn="{StaticResource Lab.Card}">
        <Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="Lab.Accent.Section" TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}">
        <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,9"/>
    </Style>
    <Style x:Key="Lab.Accent.SmallButton" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="9,5"/>
    </Style>
    <Style x:Key="Lab.Accent.Switch" TargetType="CheckBox" BasedOn="{StaticResource Lab.Switch}">
        <Setter Property="MinHeight" Value="38"/><Setter Property="MinWidth" Value="116"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="39"/></Grid.ColumnDefinitions>
                <lab:LabContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Grid Grid.Column="1" Width="39" Height="21">
                    <Border x:Name="Track" Background="{DynamicResource Lab.input}" BorderBrush="{DynamicResource Lab.muted}" BorderThickness="1" CornerRadius="11"/>
                    <Ellipse x:Name="Thumb" Width="11" Height="11" Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource Lab.muted}"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Lab.on}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lab.Accent.Set" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Lab.Font}"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="17" Height="17" CornerRadius="3" Background="{DynamicResource Lab.input}" BorderBrush="{DynamicResource Lab.muted}" BorderThickness="1" VerticalAlignment="Center">
                    <lab:LabIcon x:Name="Mark" Kind="Check" Width="15" Height="15" Foreground="{DynamicResource Lab.on}" Visibility="Collapsed"/>
                </Border>
                <lab:LabContentPresenter Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lab.Accent.Expander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Lab.text}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <Border Background="{DynamicResource Lab.panel}" BorderBrush="{DynamicResource Lab.line}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Style><Style TargetType="ToggleButton">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/><Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="HeaderSurface" Background="Transparent" Padding="18,14">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                        <lab:LabIcon x:Name="Chevron" Grid.Column="1" Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource Lab.muted}" RenderTransformOrigin="0.5,0.5"><lab:LabIcon.RenderTransform><RotateTransform/></lab:LabIcon.RenderTransform></lab:LabIcon>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource Lab.input}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ToggleButton.Style>
                    </ToggleButton>
                    <Border x:Name="ExpandedBody" BorderBrush="{DynamicResource Lab.line}" BorderThickness="0,1,0,0" Visibility="Collapsed"><ContentPresenter ContentSource="Content"/></Border>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
