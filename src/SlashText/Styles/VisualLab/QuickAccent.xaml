<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Issue #65: explicit, scoped styles from the frozen VisualLab contract. -->
    <Style x:Key="Lab.Accent.Label" TargetType="TextBlock" BasedOn="{StaticResource Lab.Metadata}">
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Lab.Accent.Choice" TargetType="Button" BasedOn="{StaticResource Lab.Button}">
        <Setter Property="MinWidth" Value="62"/><Setter Property="MinHeight" Value="66"/>
        <Setter Property="Margin" Value="5,0,5,8"/><Setter Property="FontSize" Value="26"/>
        <Setter Property="Padding" Value="10,8"/>

    </Style>
    <Style x:Key="Lab.Accent.SliderTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/><Setter Property="Height" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lab.Accent.Slider" TargetType="Slider">
        <Setter Property="MinHeight" Value="28"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lab.Focus}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" VerticalAlignment="Center">
                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Lab.Accent.SliderTrack}" Background="{DynamicResource Lab.accent}"/></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Lab.Accent.SliderTrack}" Background="{DynamicResource Lab.line-strong}"/></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Width="14" Height="14">
                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Lab.accent}" Stroke="{DynamicResource Lab.panel}" StrokeThickness="2"/></ControlTemplate></Thumb.Template>
                    </Thumb></Track.Thumb>
                </Track>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
