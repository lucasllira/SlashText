<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Namespaced: no replacements for legacy Foundation.xaml keys. Units: WPF DIP. -->
    <FontFamily x:Key="Lab.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Lab.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Lab.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="Lab.BodySize">14</sys:Double>
    <sys:Double x:Key="Lab.HeadingSize">30</sys:Double>
    <sys:Double x:Key="Lab.MetadataSize">12</sys:Double>
    <sys:Double x:Key="Lab.ControlHeight">36</sys:Double>
    <CornerRadius x:Key="Lab.ButtonRadius">6</CornerRadius>
    <CornerRadius x:Key="Lab.FieldRadius">5</CornerRadius>
    <CornerRadius x:Key="Lab.CardRadius">9</CornerRadius>
    <CornerRadius x:Key="Lab.WindowRadius">12</CornerRadius>
    <Thickness x:Key="Lab.PagePadding">30,28</Thickness>
    <Thickness x:Key="Lab.CardPadding">23</Thickness>
    <Duration x:Key="Lab.Motion.Control">0:0:0.140</Duration>
    <Duration x:Key="Lab.Motion.Page">0:0:0.180</Duration>
    <Duration x:Key="Lab.Motion.Popup">0:0:0.180</Duration>
    <Duration x:Key="Lab.Motion.Theme">0:0:0.200</Duration>
    <!-- CSS switch exception: .s-switch and :before use .18s ease. -->
    <Duration x:Key="Lab.Motion.Switch">0:0:0.180</Duration>
    <KeySpline x:Key="Lab.Motion.Ease">0.25,0.1 0.25,1</KeySpline>
    <KeySpline x:Key="Lab.Motion.EaseOut">0,0 0.58,1</KeySpline>
</ResourceDictionary>
