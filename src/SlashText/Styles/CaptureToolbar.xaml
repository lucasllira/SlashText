    <Geometry x:Key="CaptureIconText">M2.5,3.5 L17.5,3.5 M10,3.5 L10,17 M6.5,17 L13.5,17</Geometry>
    <Geometry x:Key="CaptureIconNumber">M10,2.5 A7.5,7.5 0 1 0 10,17.5 A7.5,7.5 0 1 0 10,2.5 M8,8 L10,6.5 L10,13.5 M8,13.5 L12,13.5</Geometry>
    <Geometry x:Key="CaptureIconEmoji">M10,2.5 A7.5,7.5 0 1 0 10,17.5 A7.5,7.5 0 1 0 10,2.5 M7,7.8 L7,8.2 M13,7.8 L13,8.2 M6.5,11.5 C8,14 12,14 13.5,11.5</Geometry>
    <Geometry x:Key="CaptureIconEraser">M3,14 L11.5,3 L17,8.5 L10.5,17 L6,17 Z M6.5,11 L11,15</Geometry>
    <Geometry x:Key="CaptureIconUndo">M7,5 L3,9 L7,13 M3.5,9 L11,9 C15,9 17,12 16,16</Geometry>
    <Geometry x:Key="CaptureIconRedo">M13,5 L17,9 L13,13 M16.5,9 L9,9 C5,9 3,12 4,16</Geometry>
    <Geometry x:Key="CaptureIconReselect">M3.5,7 L3.5,3.5 L7,3.5 M13,3.5 L16.5,3.5 L16.5,7 M16.5,13 L16.5,16.5 L13,16.5 M7,16.5 L3.5,16.5 L3.5,13</Geometry>
    <Geometry x:Key="CaptureIconClose">M3,3 L17,17 M17,3 L3,17</Geometry>
    <Geometry x:Key="CaptureIconMore">M4,9 A1,1 0 1 0 6,9 A1,1 0 1 0 4,9 M8,9 A1,1 0 1 0 10,9 A1,1 0 1 0 8,9 M12,9 A1,1 0 1 0 14,9 A1,1 0 1 0 12,9</Geometry>
</ResourceDictionary>
