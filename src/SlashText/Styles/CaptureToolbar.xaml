<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CaptureToolbarSurfaceBrush" Color="#F21B1F23"/>
    <SolidColorBrush x:Key="CaptureToolbarElevatedBrush" Color="#FF272B30"/>
    <SolidColorBrush x:Key="CaptureToolbarBorderBrush" Color="#667B8791"/>
    <SolidColorBrush x:Key="CaptureToolbarTextBrush" Color="#FFF6F8FA"/>
    <SolidColorBrush x:Key="CaptureToolbarSecondaryTextBrush" Color="#FFB7C0C7"/>
    <SolidColorBrush x:Key="CaptureToolbarHoverBrush" Color="#FF333A41"/>
    <SolidColorBrush x:Key="CaptureToolbarPressedBrush" Color="#FF11171C"/>
    <SolidColorBrush x:Key="CaptureToolbarSelectedBrush" Color="#FF123D46"/>
    <SolidColorBrush x:Key="CaptureToolbarDisabledBrush" Color="#667B8791"/>
    <SolidColorBrush x:Key="CaptureToolbarAccentBrush" Color="#FF20C6D9"/>
    <SolidColorBrush x:Key="CaptureToolbarDangerBrush" Color="#FFFF6B74"/>
    <SolidColorBrush x:Key="CaptureToolbarFocusBrush" Color="#FF7BE6F1"/>

    <Style x:Key="CaptureToolbarIconButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource CaptureToolbarTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CaptureToolbarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CaptureToolbarPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CaptureToolbarFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptureToolbarToggleButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource CaptureToolbarTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CaptureToolbarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CaptureToolbarPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CaptureToolbarSelectedBrush}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CaptureToolbarAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CaptureToolbarAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CaptureToolbarFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="CaptureIconArrow">M3,15 L15,3 M9,3 L15,3 L15,9</Geometry>
    <Geometry x:Key="CaptureIconHighlighter">M4,14 L8,10 L14,4 L12,2 L6,8 L2,12 Z M2,15 L8,15</Geometry>
    <Geometry x:Key="CaptureIconShapes">M2,3 L9,3 L9,10 L2,10 Z M10,9 A4,4 0 1 0 18,9 A4,4 0 1 0 10,9</Geometry>
    <Geometry x:Key="CaptureIconPencil">M3,14 L4,10 L12,2 L16,6 L8,14 Z M10,4 L14,8</Geometry>
    <Geometry x:Key="CaptureIconText">M2,3 L16,3 M9,3 L9,16 M5,16 L13,16</Geometry>
    <Geometry x:Key="CaptureIconNumber">M3,3 L15,3 L15,15 L3,15 Z M6,7 L8,5 L8,12 M11,7 C14,4 15,8 11,12 L15,12</Geometry>
    <Geometry x:Key="CaptureIconEraser">M4,14 L2,12 L10,3 L16,9 L11,14 Z M7,14 L4,11</Geometry>
    <Geometry x:Key="CaptureIconUndo">M7,5 L3,9 L7,13 M4,9 L11,9 C16,9 17,15 13,17</Geometry>
    <Geometry x:Key="CaptureIconRedo">M11,5 L15,9 L11,13 M14,9 L7,9 C2,9 1,15 5,17</Geometry>
    <Geometry x:Key="CaptureIconReselect">M4,4 L8,4 M12,4 L16,4 L16,8 M16,12 L16,16 L12,16 M8,16 L4,16 L4,12 M4,8 L4,4</Geometry>
    <Geometry x:Key="CaptureIconClose">M3,3 L15,15 M15,3 L3,15</Geometry>
    <Geometry x:Key="CaptureIconMore">M4,9 A1,1 0 1 0 6,9 A1,1 0 1 0 4,9 M8,9 A1,1 0 1 0 10,9 A1,1 0 1 0 8,9 M12,9 A1,1 0 1 0 14,9 A1,1 0 1 0 12,9</Geometry>
</ResourceDictionary>
