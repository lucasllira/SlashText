<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Visual Contract v1: preto neutro, sem tons azulados. -->
    <SolidColorBrush x:Key="Preview.Canvas" Color="#FF000000"/>
    <SolidColorBrush x:Key="Preview.Toolbar" Color="#F7111111"/>
    <SolidColorBrush x:Key="Preview.Elevated" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="Preview.Hover" Color="#FF252525"/>
    <SolidColorBrush x:Key="Preview.Pressed" Color="#FF080808"/>
    <SolidColorBrush x:Key="Preview.Selected" Color="#FF10373C"/>
    <SolidColorBrush x:Key="Preview.Border" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="Preview.Divider" Color="#FF323232"/>
    <SolidColorBrush x:Key="Preview.Text" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="Preview.Muted" Color="#FFB8B8B8"/>
    <SolidColorBrush x:Key="Preview.Disabled" Color="#FF707070"/>
    <SolidColorBrush x:Key="Preview.Accent" Color="#FF22C7D9"/>
    <SolidColorBrush x:Key="Preview.AccentHover" Color="#FF3BD4E4"/>
    <SolidColorBrush x:Key="Preview.Danger" Color="#FFFF6B73"/>

    <!-- Grade óptica 20 x 20. Cada Geometry é o asset canônico. -->
    <Geometry x:Key="PreviewIcon.Arrow">M3,16 L16,3 M9,3 L16,3 L16,10</Geometry>
    <Geometry x:Key="PreviewIcon.Highlighter">M4,14 L8,10 L14.5,3.5 L16.5,5.5 L10,12 L6,16 Z M3,17 L10,17</Geometry>
    <Geometry x:Key="PreviewIcon.Shapes">M2.5,4.5 L9,4.5 L9,11 L2.5,11 Z M11,10 A3.5,3.5 0 1 0 18,10 A3.5,3.5 0 1 0 11,10</Geometry>
    <Geometry x:Key="PreviewIcon.Pencil">M3,16 L4.2,11.5 L13.2,2.5 L17.5,6.8 L8.5,15.8 Z M11.4,4.3 L15.7,8.6</Geometry>
    <Geometry x:Key="PreviewIcon.Text">M2.5,3.5 L17.5,3.5 M10,3.5 L10,17 M6.5,17 L13.5,17</Geometry>
    <!-- Número é um marcador circular, não um quadrado com “12”. -->
    <Geometry x:Key="PreviewIcon.Number">M10,2.5 A7.5,7.5 0 1 0 10,17.5 A7.5,7.5 0 1 0 10,2.5 M8,8 L10,6.5 L10,13.5 M8,13.5 L12,13.5</Geometry>
    <Geometry x:Key="PreviewIcon.Emoji">M10,2.5 A7.5,7.5 0 1 0 10,17.5 A7.5,7.5 0 1 0 10,2.5 M7,7.8 L7,8.2 M13,7.8 L13,8.2 M6.5,11.5 C8,14 12,14 13.5,11.5</Geometry>
    <Geometry x:Key="PreviewIcon.Eraser">M3,14 L11.5,3 L17,8.5 L10.5,17 L6,17 Z M6.5,11 L11,15</Geometry>
    <Geometry x:Key="PreviewIcon.Undo">M7,5 L3,9 L7,13 M3.5,9 L11,9 C15,9 17,12 16,16</Geometry>
    <Geometry x:Key="PreviewIcon.Redo">M13,5 L17,9 L13,13 M16.5,9 L9,9 C5,9 3,12 4,16</Geometry>
    <Geometry x:Key="PreviewIcon.Reselect">M3.5,7 L3.5,3.5 L7,3.5 M13,3.5 L16.5,3.5 L16.5,7 M16.5,13 L16.5,16.5 L13,16.5 M7,16.5 L3.5,16.5 L3.5,13</Geometry>
    <Geometry x:Key="PreviewIcon.Close">M3,3 L17,17 M17,3 L3,17</Geometry>
    <Geometry x:Key="PreviewIcon.ChevronDown">M4,7 L10,13 L16,7</Geometry>
    <Geometry x:Key="PreviewIcon.Copy">M7,7 L17,7 L17,17 L7,17 Z M3,3 L13,3 L13,7 M3,3 L3,13 L7,13</Geometry>
    <Geometry x:Key="PreviewIcon.Save">M3,2.5 L15,2.5 L17.5,5 L17.5,17.5 L2.5,17.5 L2.5,2.5 Z M6,2.5 L6,8 L14,8 L14,2.5 M6,12 L14,12 L14,17.5 L6,17.5 Z</Geometry>
    <Geometry x:Key="PreviewIcon.Rectangle">M3,4 L17,4 L17,16 L3,16 Z</Geometry>
    <Geometry x:Key="PreviewIcon.Ellipse">M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3</Geometry>
    <Geometry x:Key="PreviewIcon.Line">M3,17 L17,3</Geometry>

    <Style x:Key="Preview.Icon" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="Stroke" Value="{StaticResource Preview.Text}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="Preview.IconButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="1"/>
        <!-- 40 - bordas de 1 px - padding de 9 px = viewport real de 20 px. -->
        <Setter Property="Padding" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.Pressed}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.Selected}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Preview.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Preview.CaptureButton" TargetType="Button">
        <Setter Property="Width" Value="86"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="#FF061316"/>
        <Setter Property="Background" Value="{StaticResource Preview.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            CornerRadius="8,0,0,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Preview.CaptureMenuButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Foreground" Value="#FF061316"/>
        <Setter Property="Background" Value="{StaticResource Preview.Accent}"/>
        <Setter Property="BorderBrush" Value="#FF0D7782"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,8,8,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Preview.EmojiButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.Hover}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.Selected}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Preview.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Preview.StateButton" TargetType="Button">
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Foreground" Value="{StaticResource Preview.Text}"/>
        <Setter Property="Background" Value="#FF1B1B1B"/>
        <Setter Property="BorderBrush" Value="{StaticResource Preview.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Preview.Accent}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Preview.Selected}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Preview.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Preview.ToolbarSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Preview.Toolbar}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Preview.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="7,6"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.42" Color="#FF000000"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
