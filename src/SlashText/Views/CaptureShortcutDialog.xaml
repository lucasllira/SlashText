<Window x:Class="SlashText.Views.CaptureShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashText.Views"
        Title="Atalhos de captura" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True">
    <Border Margin="18" Padding="24" Background="{DynamicResource Lab.raised}"
            BorderBrush="{DynamicResource Lab.line-strong}" BorderThickness="1" CornerRadius="11">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.38"/></Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Personalizar atalhos" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Clique em um campo e pressione a combinação desejada."
                               Style="{StaticResource Lab.Metadata}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="38" Height="38" Padding="8" Style="{StaticResource Lab.Button}"
                        ToolTip="Fechar" Click="Cancel_OnClick">
                    <Path Data="{StaticResource Lab.Icon.X}" Stroke="{DynamicResource Lab.text}"
                          StrokeThickness="1.8" Stretch="Uniform"/>
                </Button>
            </Grid>
            <TextBlock Text="Monitor" Style="{StaticResource Lab.Metadata}" Margin="0,22,0,6"/>
            <views:ShortcutRecorderBox x:Name="MonitorBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="Região" Style="{StaticResource Lab.Metadata}" Margin="0,14,0,6"/>
            <views:ShortcutRecorderBox x:Name="RegionBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="Janela" Style="{StaticResource Lab.Metadata}" Margin="0,14,0,6"/>
            <views:ShortcutRecorderBox x:Name="WindowBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="Captura longa" Style="{StaticResource Lab.Metadata}" Margin="0,14,0,6"/>
            <views:ShortcutRecorderBox x:Name="ScrollingBox" Style="{StaticResource Lab.Field}"/>
            <TextBlock Text="A roda exige Ctrl, Alt, Shift ou Win. Cada ação precisa de uma combinação diferente."
                       Style="{StaticResource Lab.Metadata}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <Border Height="1" Background="{DynamicResource Lab.line}" Margin="0,22,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource Lab.Button}" Margin="0,0,10,0" Click="Cancel_OnClick"/>
                <Button Content="Salvar atalhos" Style="{StaticResource Lab.PrimaryButton}" Click="Save_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
