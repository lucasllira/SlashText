<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:SlashText.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SlashText.Views.CaptureRuleDialog" Title="Configurações de captura" Width="700" Height="740" MaxHeight="820" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource Lab.text}" AllowsTransparency="True" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Lab.muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Lab.canvas}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Lab.canvas}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Lab.accent-text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Lab.accent}"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" Margin="18" Background="{DynamicResource Lab.raised}" BorderBrush="{DynamicResource Lab.line-strong}" BorderThickness="1" CornerRadius="11" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <!-- Only the decoration receives an effect; text and controls stay on their own render path. -->
            <Border Background="{DynamicResource Lab.raised}" CornerRadius="10" IsHitTestVisible="False">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.38" /></Border.Effect>
            </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Lab.line}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0,15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Configurações de captura" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Lab.text}" />
                    <Button Grid.Column="1" Width="38" Height="38" Padding="8" Style="{StaticResource Lab.Button}" ToolTip="Fechar" Click="Cancel_OnClick">
                        <Path Data="{StaticResource Lab.Icon.X}" Stroke="{DynamicResource Lab.text}" StrokeThickness="1.8" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>
            <TabControl x:Name="Sections" Grid.Row="1" Margin="12,12,12,0" Background="{DynamicResource Lab.raised}" Foreground="{DynamicResource Lab.text}" BorderThickness="0">
                <TabItem Header="Imagem e destino">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" FontWeight="Normal">
                        <StackPanel Margin="20">
                            <TextBlock Text="Monitor, janela e captura longa" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="AfterCaptureBox" Margin="0,6,0,10" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="Direta — copiar e salvar automaticamente" Tag="Direct" />
                                <ComboBoxItem Content="Editor — revisar antes de concluir" Tag="Editor" />
                            </ComboBox>
                            <CheckBox x:Name="CopyCheckBox" Content="Copiar após capturar" Style="{StaticResource Lab.Switch}" />
                            <CheckBox x:Name="SaveCheckBox" Content="Salvar automaticamente" Style="{StaticResource Lab.Switch}" />
                            <TextBlock Text="Destino" Style="{StaticResource Lab.Metadata}" Margin="0,14,0,0" />
                            <TextBox x:Name="DirectoryBox" Margin="0,6,0,8" Style="{StaticResource Lab.Field}" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource Lab.Button}" Click="Browse_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Lab.Icon.FolderOpen}" Width="17" Height="17" Stroke="{DynamicResource Lab.text}" StrokeThickness="1.7" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Escolher pasta" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Variáveis: {year}, {month}, {month-name}, {day}" Style="{StaticResource Lab.Metadata}" Margin="0,7,0,14" />
                            <TextBlock Text="Nome do arquivo" Style="{StaticResource Lab.Metadata}" />
                            <TextBox x:Name="FileNameBox" Margin="0,6,0,0" Style="{StaticResource Lab.Field}" />
                            <TextBlock Text="Variáveis: {date}, {time}, {type}, {app}" Style="{StaticResource Lab.Metadata}" Margin="0,7,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Formato" Style="{StaticResource Lab.Metadata}" />
                                    <ComboBox x:Name="FormatBox" Margin="0,6,0,0" Style="{StaticResource Lab.Combo}" SelectionChanged="Format_OnChanged">
                                        <ComboBoxItem Content="PNG" Tag="PNG" />
                                        <ComboBoxItem Content="JPEG" Tag="JPEG" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Qualidade JPEG" Style="{StaticResource Lab.Metadata}" />
                                    <TextBox x:Name="QualityBox" Margin="0,6,0,0" Style="{StaticResource Lab.Field}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="CursorCheckBox" Content="Incluir cursor na imagem" Style="{StaticResource Lab.Switch}" Margin="0,14,0,0" />
                            <CheckBox x:Name="HideCheckBox" Content="Ocultar SlashDesk durante a captura" Style="{StaticResource Lab.Switch}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Atraso" Style="{StaticResource Lab.Metadata}" />
                                    <ComboBox x:Name="DelayBox" Margin="0,6,0,0" Style="{StaticResource Lab.Combo}">
                                        <ComboBoxItem Content="Sem atraso" Tag="0" />
                                        <ComboBoxItem Content="3 segundos" Tag="3" />
                                        <ComboBoxItem Content="5 segundos" Tag="5" />
                                        <ComboBoxItem Content="10 segundos" Tag="10" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Limpar histórico após" Style="{StaticResource Lab.Metadata}" />
                                    <ComboBox x:Name="RetentionBox" Margin="0,6,0,0" Style="{StaticResource Lab.Combo}">
                                        <ComboBoxItem Content="30 dias" Tag="30" />
                                        <ComboBoxItem Content="90 dias" Tag="90" />
                                        <ComboBoxItem Content="180 dias" Tag="180" />
                                        <ComboBoxItem Content="Nunca" Tag="0" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Atalhos">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" FontWeight="Normal">
                        <StackPanel Margin="20">
                            <TextBlock Text="Clique no campo e pressione uma tecla, roda ou botão do mouse." TextWrapping="Wrap" Style="{StaticResource Lab.Metadata}" />
                            <TextBlock Text="Monitor" Margin="0,18,0,6" Style="{StaticResource Lab.Metadata}" />
                            <views:ShortcutRecorderBox x:Name="MonitorBox" Style="{StaticResource Lab.Field}" />
                            <TextBlock Text="Região" Margin="0,18,0,6" Style="{StaticResource Lab.Metadata}" />
                            <views:ShortcutRecorderBox x:Name="RegionBox" Style="{StaticResource Lab.Field}" />
                            <TextBlock Text="Janela" Margin="0,18,0,6" Style="{StaticResource Lab.Metadata}" />
                            <views:ShortcutRecorderBox x:Name="WindowBox" Style="{StaticResource Lab.Field}" />
                            <TextBlock Text="Captura longa" Margin="0,18,0,6" Style="{StaticResource Lab.Metadata}" />
                            <views:ShortcutRecorderBox x:Name="ScrollingBox" Style="{StaticResource Lab.Field}" />
                            <TextBlock Text="A roda exige Ctrl, Alt, Shift ou Win. Cada ação precisa de uma combinação diferente." TextWrapping="Wrap" Margin="0,16,0,0" Style="{StaticResource Lab.Metadata}" />
                            <TextBlock x:Name="ShortcutStatusText" TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource Lab.Metadata}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Vídeo e GIF">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" FontWeight="Normal">
                        <StackPanel Margin="20">
                            <TextBlock Text="Vídeo e GIF" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Qualidade e fluidez usadas ao iniciar uma gravação. Você também pode ajustar os controles rápidos da tela." TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Lab.Metadata}" />
                            <TextBlock Text="Vídeo — quadros por segundo" Margin="0,16,0,6" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="VideoFpsBox" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="24 FPS" Tag="24" />
                                <ComboBoxItem Content="30 FPS" Tag="30" />
                                <ComboBoxItem Content="60 FPS" Tag="60" />
                            </ComboBox>
                            <TextBlock Text="Vídeo — qualidade" Margin="0,16,0,6" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="VideoQualityBox" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="Baixa" Tag="Baixa" />
                                <ComboBoxItem Content="Média" Tag="Média" />
                                <ComboBoxItem Content="Alta" Tag="Alta" />
                                <ComboBoxItem Content="Muito alta" Tag="Muito alta" />
                            </ComboBox>
                            <CheckBox x:Name="RecordingCursorBox" Content="Incluir cursor nas gravações" Margin="0,18,0,0" Style="{StaticResource Lab.Switch}" />
                            <TextBlock Text="GIF — quadros por segundo" Margin="0,16,0,6" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="GifFpsBox" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="10 FPS — recomendado" Tag="10" />
                                <ComboBoxItem Content="20 FPS — equilibrado" Tag="20" />
                                <ComboBoxItem Content="30 FPS — fluido" Tag="30" />
                            </ComboBox>
                            <TextBlock Text="GIF — cores por quadro" Margin="0,16,0,6" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="GifQualityBox" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="32 — baixa" Tag="32" />
                                <ComboBoxItem Content="64 — média" Tag="64" />
                                <ComboBoxItem Content="128 — alta" Tag="128" />
                                <ComboBoxItem Content="256 — muito alta" Tag="256" />
                            </ComboBox>
                            <TextBlock Text="Mais FPS aumenta a fluidez e o uso de recursos. Mais cores no GIF aumentam a fidelidade e podem ampliar o arquivo." TextWrapping="Wrap" Margin="0,16,0,0" Style="{StaticResource Lab.Metadata}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="OCR">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" FontWeight="Normal">
                        <StackPanel Margin="20">
                            <TextBlock Text="Extração local de texto" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Os dois modelos estão incluídos no app. As preferências valem para a seleção de região e o editor." TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Lab.Metadata}" />
                            <TextBlock Text="Modelo" Margin="0,16,0,6" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="OcrModelBox" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="Best — priorizar precisão" Tag="Best" />
                                <ComboBoxItem Content="Fast — priorizar velocidade" Tag="Fast" />
                            </ComboBox>
                            <TextBlock Text="Best é o padrão. Fast costuma ser mais rápido, com possíveis perdas na leitura. Nenhum modelo garante acerto em fontes estilizadas ou imagens com pouca definição." TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Lab.Metadata}" />
                            <TextBlock Text="Idiomas" Margin="0,16,0,6" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="OcrLanguageBox" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="Português + inglês" Tag="por+eng" />
                                <ComboBoxItem Content="Português" Tag="por" />
                                <ComboBoxItem Content="Inglês" Tag="eng" />
                            </ComboBox>
                            <TextBlock Text="Organização do texto" Margin="0,16,0,6" Style="{StaticResource Lab.Metadata}" />
                            <ComboBox x:Name="OcrLayoutBox" Style="{StaticResource Lab.Combo}">
                                <ComboBoxItem Content="Automática — páginas e interfaces" Tag="Auto" />
                                <ComboBoxItem Content="Bloco — títulos ou parágrafos juntos" Tag="Block" />
                                <ComboBoxItem Content="Texto espalhado — trechos separados" Tag="Sparse" />
                            </ComboBox>
                            <CheckBox x:Name="OcrImproveCheckBox" Content="Tentar melhorar imagens difíceis" Margin="0,18,0,0" Style="{StaticResource Lab.Switch}" />
                            <TextBlock Text="Se a confiança estiver baixa, tenta outras formas de separar as linhas e tratar o contraste. Pode levar mais tempo. Revise o resultado antes de copiar." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Lab.Metadata}" />
                            <TextBlock Text="Tesseract 5.2.0 · Sem treinamento próprio · Nenhum envio à internet" TextWrapping="Wrap" Margin="0,20,0,0" Style="{StaticResource Lab.Metadata}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Lab.line}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource Lab.Button}" Margin="0,0,10,0" Click="Cancel_OnClick" />
                    <Button Style="{StaticResource Lab.Pilot.PrimaryButton}" Click="Save_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Lab.Icon.Check}" Width="16" Height="16" Stroke="{DynamicResource Lab.on}" StrokeThickness="1.8" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Salvar configurações" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>
