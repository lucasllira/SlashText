<Window x:Class="SlashText.Views.DesignGalleryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lab="clr-namespace:SlashText.Design" Title="SlashDesk — Galeria de desenvolvimento #62"
 Width="1440" Height="900" MinWidth="980" MinHeight="680" Background="{DynamicResource Lab.shell}"
 FontFamily="{DynamicResource Lab.Font}" FontSize="14" Foreground="{DynamicResource Lab.text}"
 Loaded="GalleryLoaded" Closed="GalleryClosed" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SlashDesk;component/Styles/VisualLab/Components.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Lab.Text}"/>
 </ResourceDictionary></Window.Resources>
 <Grid x:Name="GalleryRoot" Background="{DynamicResource Lab.shell}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="30,24,30,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Fundação visual" Style="{StaticResource Lab.Heading}"/>
    <TextBlock Text="Galeria WPF · contrato 11 · desenvolvimento #62" Style="{StaticResource Lab.Metadata}" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <RadioButton x:Name="LightTheme" Content="Claro" GroupName="Theme" Tag="Light" IsChecked="True" Style="{StaticResource Lab.Tab}" Checked="ThemeChanged"/>
    <RadioButton x:Name="DarkTheme" Content="Preto" GroupName="Theme" Tag="Dark" Style="{StaticResource Lab.Tab}" Checked="ThemeChanged"/>
    <RadioButton Content="Windows" GroupName="Theme" Tag="System" Style="{StaticResource Lab.Tab}" Checked="ThemeChanged"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource Lab.line}" BorderThickness="0,1,0,1" Padding="20,4">
   <WrapPanel>
    <RadioButton x:Name="FirstTab" Content="Atalhos" GroupName="Pages" IsChecked="True" Style="{StaticResource Lab.Tab}" Checked="TabChanged"/>
    <RadioButton Content="Captura" GroupName="Pages" Style="{StaticResource Lab.Tab}" Checked="TabChanged"/>
    <RadioButton Content="Acento Rápido" GroupName="Pages" Style="{StaticResource Lab.Tab}" Checked="TabChanged"/>
    <RadioButton Content="Estatísticas" GroupName="Pages" Style="{StaticResource Lab.Tab}" Checked="TabChanged"/>
    <RadioButton Content="Configurações" GroupName="Pages" Style="{StaticResource Lab.Tab}" Checked="TabChanged"/>
    <RadioButton Content="Sobre" GroupName="Pages" Style="{StaticResource Lab.Tab}" Checked="TabChanged"/>
   </WrapPanel>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,24">
   <StackPanel x:Name="PageSurface" lab:LabMotion.Entrance="Page">
    <TextBlock Text="Estados reais, componentes reutilizáveis" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Use Tab/Shift+Tab, Espaço, Enter, setas e Escape. Passe o mouse e pressione os controles para conferir as transições." Style="{StaticResource Lab.Metadata}" Margin="0,7,0,18"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Lab.Card}" VerticalAlignment="Top"><StackPanel>
      <TextBlock Text="Botões e foco" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,18"/>
      <Button x:Name="NormalButton" Content="Ação secundária" Style="{StaticResource Lab.Button}" Click="ActionClicked" Margin="0,0,0,10"/>
      <Button x:Name="PrimaryButton" Content="Ação principal" Style="{StaticResource Lab.PrimaryButton}" Click="ActionClicked" Margin="0,0,0,10"/>
      <Button Content="Indisponível" Style="{StaticResource Lab.Button}" IsEnabled="False" Margin="0,0,0,14"/>
      <TextBlock Text="A navegação por teclado mostra o anel de foco. O estado pressionado não altera o layout." Style="{StaticResource Lab.Metadata}"/>
     </StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Lab.Card}" VerticalAlignment="Top"><StackPanel>
      <TextBlock Text="Campos e seleção" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,14"/>
      <Label Target="{Binding ElementName=ValidField}" Padding="0,0,0,7"><TextBlock Text="Nome" Foreground="{DynamicResource Lab.muted}"/></Label>
      <TextBox x:Name="ValidField" Text="Resposta de boas-vindas" Style="{StaticResource Lab.Field}" AutomationProperties.Name="Nome de exemplo" Margin="0,0,0,12"/>
      <ComboBox x:Name="FormatCombo" SelectedIndex="0" Style="{StaticResource Lab.Combo}" AutomationProperties.Name="Formato de exemplo" Margin="0,0,0,12">
       <ComboBoxItem Content="PNG — imagem"/><ComboBoxItem Content="JPEG — imagem"/><ComboBoxItem Content="GIF — gravação"/>
      </ComboBox>
      <TextBox x:Name="InvalidField" Style="{StaticResource Lab.Field}" TextChanged="ValidateField" AutomationProperties.Name="Campo obrigatório de exemplo"/>
      <TextBlock x:Name="ValidationMessage" Text="Campo obrigatório. Digite para corrigir." Foreground="{DynamicResource Lab.error}" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel></Border>
     <Border Grid.Column="4" Style="{StaticResource Lab.Card}" VerticalAlignment="Top"><StackPanel>
      <TextBlock Text="Switches e movimento" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,10"/>
      <CheckBox x:Name="EnabledSwitch" Content="Ativado" IsChecked="True" Style="{StaticResource Lab.Switch}"/>
      <CheckBox Content="Desativado" Style="{StaticResource Lab.Switch}"/>
      <CheckBox Content="Indisponível" IsEnabled="False" Style="{StaticResource Lab.Switch}"/>
      <CheckBox x:Name="ReducedSwitch" Content="Reduzir movimentos" Style="{StaticResource Lab.Switch}" Checked="MotionChanged" Unchecked="MotionChanged"/>
      <Button Content="Repetir entrada" Style="{StaticResource Lab.Button}" Click="ReplayClicked" Margin="0,14,0,0"/>
     </StackPanel></Border>
    </Grid>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Lab.Card}"><StackPanel>
      <TextBlock Text="Popup e estados" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
      <Button x:Name="PopupButton" Content="Abrir opções" Style="{StaticResource Lab.Button}" Click="PopupClicked"/>
      <TextBlock x:Name="Status" Text="Pronto para testar." Style="{StaticResource Lab.Metadata}" Margin="0,12,0,0"/>
      <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=PopupButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="PopupOpened" Closed="PopupClosed">
       <Border x:Name="PopupContent" Style="{StaticResource Lab.Popup}" Width="290" Margin="0,5,0,0" KeyDown="PopupKeyDown">
        <StackPanel><TextBlock Text="Opções de exemplo" Style="{StaticResource Lab.Text}" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <CheckBox Content="Mostrar detalhes" Style="{StaticResource Lab.Switch}"/>
         <Button x:Name="ClosePopupButton" Content="Concluir" Style="{StaticResource Lab.PrimaryButton}" Click="ClosePopupClicked"/>
        </StackPanel>
       </Border>
      </Popup>
     </StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Lab.Card}"><StackPanel>
      <TextBlock Text="Ícones vetoriais locais" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
      <WrapPanel x:Name="IconsPanel"/>
      <TextBlock Text="Lucide · viewport 24 × 24 · sem fonte de ícones externa" Style="{StaticResource Lab.Metadata}" Margin="0,12,0,0"/>
     </StackPanel></Border>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="3" BorderBrush="{DynamicResource Lab.line}" BorderThickness="0,1,0,0" Padding="30,10">
   <TextBlock Text="Ambiente isolado: nenhuma captura, gravação, atualização ou gravação de dados pessoais é executada nesta galeria." Style="{StaticResource Lab.Metadata}"/>
  </Border>
 </Grid>
</Window>
