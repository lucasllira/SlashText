<Window x:Class="SlashText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashText"
        Icon="Assets/SlashText.ico"
        Width="1320"
        Height="850"
        MinWidth="1080"
        MinHeight="800"
        SizeChanged="MainWindow_OnSizeChanged"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/SlashText.png"
                       Width="40"
                       Height="40"
                       Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel>
                    <TextBlock Text="SlashText"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="Seus textos prontos, em qualquer lugar."
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource ElevatedBrush}"
                    CornerRadius="14"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock x:Name="MonitorStatusText"
                           Text="● Iniciando monitoramento"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="12"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                HorizontalAlignment="Left"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ShortcutsTabButton" Content="Atalhos"
                        Style="{StaticResource NavButton}"
                        Click="ShortcutsTab_OnClick"/>
                <Button x:Name="QuickAccentTabButton" Content="Acento Rápido"
                        Style="{StaticResource NavButton}"
                        Click="QuickAccentTab_OnClick"/>
                <Button x:Name="StatisticsTabButton" Content="Estatísticas"
                        Style="{StaticResource NavButton}"
                        Click="StatisticsTab_OnClick"/>
                <Button x:Name="SettingsTabButton" Content="Configurações"
                        Style="{StaticResource NavButton}"
                        Click="SettingsTab_OnClick"/>
                <Button x:Name="AboutTabButton" Content="Sobre"
                        Style="{StaticResource NavButton}"
                        Click="AboutTab_OnClick"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="18"
                ClipToBounds="True">
                <Grid>
                    <Grid x:Name="ShortcutsView">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ShortcutPrimaryRow" Height="*"/>
                            <RowDefinition x:Name="ShortcutSecondaryRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ShortcutLeftColumn" Width="260"/>
                            <ColumnDefinition x:Name="ShortcutLeftDividerColumn" Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ShortcutRightDividerColumn" Width="1"/>
                            <ColumnDefinition x:Name="ShortcutRightColumn" Width="260"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="ShortcutSidebarPanel" Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchBox"
                                     TextChanged="SearchBox_OnTextChanged"
                                     ToolTip="Buscar por nome, comando ou categoria"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CategoriesPanel"/>
                            </ScrollViewer>
                            <Border Grid.Row="4"
                                    Background="{DynamicResource ElevatedBrush}"
                                    CornerRadius="10"
                                    Padding="11">
                                <StackPanel>
                                    <TextBlock Text="Mais usados" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"/>
                                    <StackPanel x:Name="MostUsedPanel" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Row="6" Content="+ Novo atalho"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="NewSnippet_OnClick"/>
                        </Grid>

                        <Border x:Name="ShortcutLeftDivider"
                                Grid.Column="1"
                                Background="{DynamicResource DividerBrush}"/>

                        <ScrollViewer x:Name="ShortcutEditorPanel"
                                      Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="210"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nome" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBox x:Name="NameBox" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Comando" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBox x:Name="TriggerBox" Margin="0,6,0,0"
                                                 ToolTip="Use /atalho ou :atalho"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Categoria" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBox x:Name="CategoryBox" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Formato" Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="FormatBox" Margin="0,6,0,0" Padding="9"
                                                  SelectedIndex="0"
                                                  SelectionChanged="FormatBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Texto simples"/>
                                            <ComboBoxItem Content="Texto formatado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel x:Name="FormattingToolbar" Grid.Row="4" Visibility="Collapsed">
                                    <TextBlock Text="Formatação" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <ComboBox x:Name="FontFamilyBox"
                                              Width="132"
                                              MinHeight="34"
                                              Margin="0,0,6,6"
                                              ToolTip="Fonte"
                                              SelectedIndex="0"
                                              SelectionChanged="FontFamilyBox_OnSelectionChanged">
                                        <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                                        <ComboBoxItem Content="Arial" Tag="Arial"/>
                                        <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                                        <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                                        <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                                    </ComboBox>
                                    <ComboBox x:Name="FontSizeBox"
                                              Width="68"
                                              MinHeight="34"
                                              Margin="0,0,6,6"
                                              ToolTip="Tamanho da fonte"
                                              SelectedIndex="2"
                                              SelectionChanged="FontSizeBox_OnSelectionChanged">
                                        <ComboBoxItem Content="9" Tag="12"/>
                                        <ComboBoxItem Content="10" Tag="13.333"/>
                                        <ComboBoxItem Content="11" Tag="14.667"/>
                                        <ComboBoxItem Content="12" Tag="16"/>
                                        <ComboBoxItem Content="14" Tag="18.667"/>
                                        <ComboBoxItem Content="16" Tag="21.333"/>
                                        <ComboBoxItem Content="18" Tag="24"/>
                                        <ComboBoxItem Content="24" Tag="32"/>
                                    </ComboBox>
                                    <Button Content="B" FontWeight="Bold"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Negrito" Click="Bold_OnClick"/>
                                    <Button Content="I" FontStyle="Italic"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Itálico" Click="Italic_OnClick"/>
                                    <Button Content="U"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Sublinhado" Click="Underline_OnClick"/>
                                    <Button Content="Cor"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Cor do texto" Click="Color_OnClick"/>
                                    <Button Content="Marca-texto"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Cor de destaque do texto"
                                            Click="Highlight_OnClick"/>
                                    <Button Content="Link"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Inserir hiperlink" Click="Link_OnClick"/>
                                    <Button Content="Imagem"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Adicionar imagem ao atalho" Click="Image_OnClick"/>
                                    <Button Content="• Lista"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Lista com marcadores"
                                            Click="Bullets_OnClick"/>
                                    <Button Content="1. Lista"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Lista numerada"
                                            Click="Numbering_OnClick"/>
                                    <Button Content="≡ Esq."
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Alinhar à esquerda"
                                            Click="AlignLeft_OnClick"/>
                                    <Button Content="≡ Centro"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Centralizar"
                                            Click="AlignCenter_OnClick"/>
                                    <Button Content="≡ Dir."
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Alinhar à direita"
                                            Click="AlignRight_OnClick"/>
                                    <Button Content="Tabela"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Inserir tabela"
                                            Click="Table_OnClick"/>
                                </WrapPanel>

                                <Border Grid.Row="6"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Background="{DynamicResource InputBrush}">
                                    <RichTextBox x:Name="ContentEditor"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 CaretBrush="{DynamicResource InkBrush}"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 SelectionOpacity="0.3"
                                                 Padding="12"
                                                 AcceptsTab="True"
                                                 TextChanged="ContentEditor_OnTextChanged"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Segoe UI"
                                                 FontSize="14">
                                        <FlowDocument PagePadding="0"
                                                      Foreground="{DynamicResource InkBrush}"/>
                                    </RichTextBox>
                                </Border>

                                <TextBlock Grid.Row="8" Text="Preview do resultado"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"/>
                                <Border Grid.Row="10"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Background="{DynamicResource ElevatedBrush}"
                                        Padding="12">
                                    <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                                              VerticalScrollBarVisibility="Auto"
                                                              IsToolBarVisible="False"
                                                              Background="Transparent"
                                                              Foreground="{DynamicResource InkBrush}">
                                        <FlowDocument x:Name="PreviewDocument"
                                                      PagePadding="0"
                                                      Foreground="{DynamicResource InkBrush}"/>
                                    </FlowDocumentScrollViewer>
                                </Border>

                                <Grid Grid.Row="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <Button Grid.Column="1" Content="Excluir"
                                            Style="{StaticResource DangerButton}"
                                            Click="DeleteSnippet_OnClick"/>
                                    <Button Grid.Column="3" Content="Salvar atalho"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="SaveSnippet_OnClick"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <Border x:Name="ShortcutRightDivider"
                                Grid.Column="3"
                                Background="{DynamicResource DividerBrush}"/>

                        <ScrollViewer x:Name="ShortcutVariablesPanel"
                                      Grid.Column="4"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18">
                                <TextBlock Text="Variáveis"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="Clique para inserir. Passe o mouse para ver a descrição."
                                           Margin="0,4,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"/>
                                <Expander Header="Campos e navegação" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{nome}}" Tag="{}{{nome}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Solicita um valor chamado nome antes da expansão."
                                                Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{campo|padrão}}" Tag="{}{{campo|valor padrão}}"
                                                Style="{StaticResource VariableButton}"
                                                ToolTip="Campo preenchível com um valor inicial sugerido."
                                                Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{tab}}" Tag="{}{{tab}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Avança para o próximo campo do aplicativo, como assunto → corpo."
                                                Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Data e hora" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{data}}" Tag="{}{{data}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual em dd/MM/yyyy." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data_curta}}" Tag="{}{{data_curta}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual abreviada em dd/MM/yy." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data_extensa}}" Tag="{}{{data_extensa}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data por extenso com dia da semana, mês e ano." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{hora}}" Tag="{}{{hora}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Hora atual em HH:mm." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data:+7d}}" Tag="{}{{data:+7d}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual mais 7 dias. Aceita d, m ou y e sinais + ou -."
                                                Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Partes da data" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{dia}}" Tag="{}{{dia}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Número do dia." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{dia_semana}}" Tag="{}{{dia_semana}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Dia da semana por extenso." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{dia_semana_curto}}" Tag="{}{{dia_semana_curto}}"
                                                Style="{StaticResource VariableButton}"
                                                ToolTip="Dia da semana abreviado." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes}}" Tag="{}{{mes}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Número do mês." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes_nome}}" Tag="{}{{mes_nome}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Mês por extenso." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes_curto}}" Tag="{}{{mes_curto}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Mês abreviado." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{ano}}" Tag="{}{{ano}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Ano com quatro dígitos." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{ano_curto}}" Tag="{}{{ano_curto}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Ano com dois dígitos." Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Sistema">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{usuario}}" Tag="{}{{usuario}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Nome do usuário conectado ao Windows." Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer x:Name="QuickAccentView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32" MaxWidth="1120" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Acento Rápido" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Acentos e caracteres especiais sem trocar o layout do teclado."
                                           Style="{StaticResource PageDescription}"/>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SettingsCard}"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="13">
                                        <TextBlock Text="á"
                                                   Foreground="White"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Segure uma letra, pressione a tecla de ativação e escolha o caractere."
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Exemplo: segure A + Espaço, navegue pelas opções e solte A para inserir á."
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="1.12*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Ativação e barra"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0,0,0,9"/>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="QuickAccentEnabledCheckBox"
                                                      Content="Ativar Acento Rápido"
                                                      FontWeight="SemiBold"
                                                      Click="QuickAccentSettings_OnChanged"/>
                                            <Border Height="1"
                                                    Background="{DynamicResource DividerBrush}"
                                                    Margin="0,8,0,16"/>
                                            <TextBlock Text="Tecla de ativação"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <ComboBox x:Name="QuickAccentActivationBox"
                                                      Margin="0,6,0,14"
                                                      SelectionChanged="QuickAccentSettings_OnChanged">
                                                <ComboBoxItem Content="Espaço" Tag="Space"/>
                                                <ComboBoxItem Content="Seta esquerda" Tag="Left"/>
                                                <ComboBoxItem Content="Seta direita" Tag="Right"/>
                                            </ComboBox>
                                            <TextBlock Text="Posição da barra"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <ComboBox x:Name="QuickAccentPositionBox"
                                                      Margin="0,6,0,8"
                                                      SelectionChanged="QuickAccentSettings_OnChanged">
                                                <ComboBoxItem Content="Centro inferior" Tag="BottomCenter"/>
                                                <ComboBoxItem Content="Centro" Tag="Center"/>
                                                <ComboBoxItem Content="Centro superior" Tag="TopCenter"/>
                                            </ComboBox>
                                            <CheckBox x:Name="QuickAccentUnicodeCheckBox"
                                                      Content="Mostrar código Unicode"
                                                      Click="QuickAccentSettings_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentSortCheckBox"
                                                      Content="Priorizar caracteres mais usados"
                                                      Click="QuickAccentSettings_OnChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Comportamento"
                                               Style="{StaticResource SectionTitle}"/>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Atraso para ativação (ms)"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBox x:Name="QuickAccentDelayBox"
                                                     Width="180"
                                                     HorizontalAlignment="Left"
                                                     Margin="0,7,0,0"
                                                     LostFocus="QuickAccentSettings_OnChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Conjuntos de caracteres"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0,0,0,9"/>
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Escolha o que aparece na barra"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="QuickAccentSetSummaryText"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal">
                                                    <Button Content="Somente PT-BR"
                                                            Style="{StaticResource ToolbarButton}"
                                                            Click="QuickAccentPortugueseOnly_OnClick"/>
                                                    <Button Content="Todos"
                                                            Style="{StaticResource ToolbarButton}"
                                                            Margin="0"
                                                            Click="QuickAccentSelectAll_OnClick"/>
                                                </StackPanel>
                                            </Grid>

                                            <UniformGrid Columns="2" Margin="0,16,0,8">
                                                <CheckBox x:Name="QuickAccentPortugueseCheckBox"
                                                          Content="Português (Brasil)"
                                                          Tag="PortugueseBrazil"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentSpanishCheckBox"
                                                          Content="Espanhol"
                                                          Tag="Spanish"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentFrenchCheckBox"
                                                          Content="Francês"
                                                          Tag="French"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentGermanCheckBox"
                                                          Content="Alemão"
                                                          Tag="German"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentItalianCheckBox"
                                                          Content="Italiano"
                                                          Tag="Italian"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentNordicCheckBox"
                                                          Content="Idiomas nórdicos"
                                                          Tag="Nordic"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentCentralEuropeanCheckBox"
                                                          Content="Europa Central"
                                                          Tag="CentralEuropean"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentCurrencyCheckBox"
                                                          Content="Moedas"
                                                          Tag="Currency"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                                <CheckBox x:Name="QuickAccentSpecialCheckBox"
                                                          Content="Símbolos especiais"
                                                          Tag="Special"
                                                          Click="QuickAccentCharacterSet_OnChanged"/>
                                            </UniformGrid>

                                            <Border Background="{DynamicResource InputBrush}"
                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Prévia dos caracteres"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock x:Name="QuickAccentCharactersPreviewText"
                                                               Margin="0,8,0,0"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="18"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}"
                                            Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Aplicativos excluídos"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,5,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Text="O Acento Rápido não será ativado nestes processos. Informe um por linha, como game.exe."/>
                                            <TextBox x:Name="QuickAccentExcludedAppsBox"
                                                     Height="86"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Margin="0,10,0,0"
                                                     LostFocus="QuickAccentSettings_OnChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="StatisticsView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32" MaxWidth="1120" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Estatísticas" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Atalhos e Acento Rápido reunidos em uma visão simples do uso."
                                           Style="{StaticResource PageDescription}"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="2" Columns="4">
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Expansões de texto"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="TotalExpansionsText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Atalhos usados"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="UsedSnippetsText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Caracteres poupados"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="CharactersSavedText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Tempo estimado"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="TimeSavedText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Atalhos mais usados"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Ranking por quantidade de expansões"
                                                   Margin="0,4,0,12"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <StackPanel x:Name="StatisticsRankingPanel"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Acento Rápido"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <Grid Margin="0,14,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Inserções"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="QuickAccentTotalText"
                                                           Style="{StaticResource MetricValue}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource DividerBrush}"
                                                    Margin="12,0"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Mais usado"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="QuickAccentFavoriteText"
                                                           Style="{StaticResource MetricValue}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Caracteres mais inseridos"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <WrapPanel x:Name="QuickAccentCharactersPanel"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="6"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    CornerRadius="10"
                                    Padding="14,11">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="Privacidade: somente contagens são salvas neste computador. O conteúdo digitado e os textos expandidos nunca são registrados."/>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32" MaxWidth="1000" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Configurações" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Preferências do aplicativo, aparência e funcionamento no Windows."
                                           Style="{StaticResource PageDescription}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Aparência"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Tema do SlashText"
                                                   Margin="0,18,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="ThemeBox"
                                                  Margin="0,7,0,0"
                                                  SelectionChanged="ThemeBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Seguir o Windows" Tag="System"/>
                                            <ComboBoxItem Content="Claro" Tag="Light"/>
                                            <ComboBoxItem Content="Escuro" Tag="Dark"/>
                                        </ComboBox>
                                        <TextBlock Text="A mudança é aplicada em todas as telas, diálogos e menus."
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Comportamento"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <CheckBox x:Name="CloseToTrayCheckBox"
                                                  Content="Manter na bandeja ao fechar"
                                                  Margin="0,16,0,7"
                                                  Click="Settings_OnClick"/>
                                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                                  Content="Iniciar com o Windows"
                                                  Click="Settings_OnClick"/>
                                        <CheckBox x:Name="ShowSuggestionsCheckBox"
                                                  Content="Mostrar sugestões ao digitar / ou :"
                                                  Click="Settings_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Arquivos e backup"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="A pasta SlashTextData reúne snippets.md, preferências, estatísticas e imagens. O Markdown continua editável."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Margin="0,9,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="A pasta backups mantém um ZIP por dia, no máximo sete, com atalhos, preferências e estatísticas."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Privacidade"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Sem conta, telemetria ou conexão obrigatória. O conteúdo digitado permanece no computador."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Border Background="{DynamicResource AccentSubtleBrush}"
                                                CornerRadius="8"
                                                Padding="10,7"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="100% local"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="40" MaxWidth="920" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SettingsCard}"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="Assets/SlashText.png"
                                           Width="104"
                                           Height="104"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="SlashText"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="32"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Expansor de textos e acentos para Windows"
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Versão 1.4.1 · Licença MIT · código aberto"
                                                   Margin="0,12,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Feito para reduzir trabalho repetitivo"
                                           Style="{StaticResource PageTitle}"
                                           FontSize="22"/>
                                <TextBlock Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Text="Crie atalhos reutilizáveis, preencha variáveis, insira datas automaticamente, mantenha formatação onde o aplicativo permitir e digite acentos em teclados internacionais."/>
                            </StackPanel>

                            <UniformGrid Grid.Row="4" Columns="2">
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Principais recursos"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Atalhos / e :, variáveis, campos preenchíveis, Tab entre campos, texto formatado, imagens, preview, estatísticas e Acento Rápido."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Projeto aberto"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Código disponível no GitHub para estudo, auditoria e colaboração sob a licença MIT."/>
                                        <Button Content="Abrir projeto no GitHub"
                                                HorizontalAlignment="Left"
                                                Margin="0,14,0,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="OpenGitHub_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
        </Border>
    </Grid>
</Window>
