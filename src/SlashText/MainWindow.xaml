                                                           FontFamily="Cascadia Mono, Consolas" FontSize="18"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="6" Style="{StaticResource SettingsCard}" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="1.15*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Aplicativos excluídos" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="O Acento Rápido não será exibido nos processos informados."/>
                                    </StackPanel>
                                    <TextBox Grid.Column="2" x:Name="QuickAccentExcludedAppsBox"
                                             Height="74" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="Informe um processo por linha, como mstsc.exe ou game.exe"
                                             LostFocus="QuickAccentSettings_OnChanged"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="CaptureView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="1180" HorizontalAlignment="Center">
                             <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="20"/>
                                 <RowDefinition Height="Auto"/>
                             </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Captura de tela" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Capturas e edições 100% locais, rápidas e privadas."
