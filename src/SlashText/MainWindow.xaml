                                            <CheckBox x:Name="QuickAccentSpanishCheckBox" Content="Espanhol"
                                                      Tag="Spanish" Click="QuickAccentCharacterSet_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentFrenchCheckBox" Content="Francês"
                                                      Tag="French" Click="QuickAccentCharacterSet_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentGermanCheckBox" Content="Alemão"
                                                      Tag="German" Click="QuickAccentCharacterSet_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentItalianCheckBox" Content="Italiano"
                                                      Tag="Italian" Click="QuickAccentCharacterSet_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentNordicCheckBox" Content="Idiomas nórdicos"
                                                      Tag="Nordic" Click="QuickAccentCharacterSet_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentCentralEuropeanCheckBox" Content="Europa Central"
                                                      Tag="CentralEuropean" Click="QuickAccentCharacterSet_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentCurrencyCheckBox" Content="Moedas"
                                                      Tag="Currency" Click="QuickAccentCharacterSet_OnChanged"/>
                                            <CheckBox x:Name="QuickAccentSpecialCheckBox" Content="Símbolos especiais"
                                                      Tag="Special" Click="QuickAccentCharacterSet_OnChanged"/>
