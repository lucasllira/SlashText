<Window x:Class="SlashText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashText.Views"
        Title="SlashDesk"
        Icon="Assets/SlashDesk.ico"
        Width="1320"
        Height="850"
        MinWidth="1080"
        MinHeight="800"
        SizeChanged="MainWindow_OnSizeChanged"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,8,0,6">
                <Image Source="Assets/SlashDesk.png"
                       Width="46"
                       Height="46"
                       Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SlashDesk"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="Textos, acentos e capturas. Tudo local."
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1"
                    Style="{StaticResource StatusPill}"
                    Margin="0,8,12,6"
                    VerticalAlignment="Center">
                <TextBlock x:Name="MonitorStatusText"
                           Text="● Iniciando monitoramento"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="12"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ShortcutsTabButton" Content="Atalhos"
                            Style="{StaticResource NavButton}"
                            Click="ShortcutsTab_OnClick"/>
                    <Button x:Name="QuickAccentTabButton" Content="Acento Rápido"
                            Style="{StaticResource NavButton}"
                            Click="QuickAccentTab_OnClick"/>
                    <Button x:Name="CaptureTabButton" Content="Captura"
                            Style="{StaticResource NavButton}"
                            Click="CaptureTab_OnClick"/>
                    <Button x:Name="StatisticsTabButton" Content="Estatísticas"
                            Style="{StaticResource NavButton}"
                            Click="StatisticsTab_OnClick"/>
                    <Button x:Name="SettingsTabButton" Content="Configurações"
                            Style="{StaticResource NavButton}"
                            Click="SettingsTab_OnClick"/>
                    <Button x:Name="AboutTabButton" Content="Sobre"
                            Style="{StaticResource NavButton}"
                            Click="AboutTab_OnClick"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="100% local  ·  sem upload"
                           Margin="18,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
                <Grid>
                    <Grid x:Name="ShortcutsView">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ShortcutPrimaryRow" Height="*"/>
                            <RowDefinition x:Name="ShortcutSecondaryRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ShortcutLeftColumn" Width="260"/>
                            <ColumnDefinition x:Name="ShortcutLeftDividerColumn" Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ShortcutRightDividerColumn" Width="1"/>
                            <ColumnDefinition x:Name="ShortcutRightColumn" Width="260"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="ShortcutSidebarPanel" Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchBox"
                                     TextChanged="SearchBox_OnTextChanged"
                                     ToolTip="Buscar por nome, comando ou categoria"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CategoriesPanel"/>
                            </ScrollViewer>
                            <Border Grid.Row="4"
                                    Background="{DynamicResource ElevatedBrush}"
                                    CornerRadius="10"
                                    Padding="11">
                                <StackPanel>
                                    <TextBlock Text="Mais usados" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"/>
                                    <StackPanel x:Name="MostUsedPanel" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Row="6" Content="+ Novo atalho"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="NewSnippet_OnClick"/>
                        </Grid>

                        <Border x:Name="ShortcutLeftDivider"
                                Grid.Column="1"
                                Background="{DynamicResource DividerBrush}"/>

                        <ScrollViewer x:Name="ShortcutEditorPanel"
                                      Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="210"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nome" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBox x:Name="NameBox" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Comando" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBox x:Name="TriggerBox" Margin="0,6,0,0"
                                                 ToolTip="Use /atalho ou :atalho"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Categoria" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBox x:Name="CategoryBox" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Formato" Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="FormatBox" Margin="0,6,0,0" Padding="9"
                                                  SelectedIndex="0"
                                                  SelectionChanged="FormatBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Texto simples"/>
                                            <ComboBoxItem Content="Texto formatado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="FormattingToolbar" Grid.Row="4" Visibility="Collapsed">
                                    <WrapPanel>
                                        <TextBlock Text="Texto" VerticalAlignment="Center" Width="76"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="FontFamilyBox"
                                              Width="132"
                                              MinHeight="34"
                                              Margin="0,0,6,6"
                                              ToolTip="Fonte"
                                              SelectedIndex="0"
                                              SelectionChanged="FontFamilyBox_OnSelectionChanged">
                                        <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                                        <ComboBoxItem Content="Arial" Tag="Arial"/>
                                        <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                                        <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                                        <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                                        </ComboBox>
                                        <ComboBox x:Name="FontSizeBox"
                                              Width="68"
                                              MinHeight="34"
                                              Margin="0,0,6,6"
                                              ToolTip="Tamanho da fonte"
                                              SelectedIndex="2"
                                              SelectionChanged="FontSizeBox_OnSelectionChanged">
                                        <ComboBoxItem Content="9" Tag="12"/>
                                        <ComboBoxItem Content="10" Tag="13.333"/>
                                        <ComboBoxItem Content="11" Tag="14.667"/>
                                        <ComboBoxItem Content="12" Tag="16"/>
                                        <ComboBoxItem Content="14" Tag="18.667"/>
                                        <ComboBoxItem Content="16" Tag="21.333"/>
                                        <ComboBoxItem Content="18" Tag="24"/>
                                        <ComboBoxItem Content="24" Tag="32"/>
                                        </ComboBox>
                                        <Button Content="B" FontWeight="Bold"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Negrito" Click="Bold_OnClick"/>
                                    <Button Content="I" FontStyle="Italic"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Itálico" Click="Italic_OnClick"/>
                                    <Button Content="U"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Sublinhado" Click="Underline_OnClick"/>
                                    <Button Content="Cor"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Cor do texto" Click="Color_OnClick"/>
                                        <Button Content="Marca-texto"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Cor de destaque do texto"
                                            Click="Highlight_OnClick"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Inserir" VerticalAlignment="Center" Width="76"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="Link"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Inserir hiperlink" Click="Link_OnClick"/>
                                    <Button Content="Imagem"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Adicionar imagem ao atalho" Click="Image_OnClick"/>
                                    <Button Content="• Lista"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Lista com marcadores"
                                            Click="Bullets_OnClick"/>
                                        <Button Content="1. Lista"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Lista numerada"
                                            Click="Numbering_OnClick"/>
                                        <Button Content="Tabela"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Inserir tabela"
                                            Click="Table_OnClick"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Parágrafo" VerticalAlignment="Center" Width="76"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="≡ Esq."
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Alinhar à esquerda"
                                            Click="AlignLeft_OnClick"/>
                                    <Button Content="≡ Centro"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Centralizar"
                                            Click="AlignCenter_OnClick"/>
                                    <Button Content="≡ Dir."
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Alinhar à direita"
                                            Click="AlignRight_OnClick"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Row="6"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Background="{DynamicResource InputBrush}">
                                    <RichTextBox x:Name="ContentEditor"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 CaretBrush="{DynamicResource InkBrush}"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 SelectionOpacity="0.3"
                                                 Padding="12"
                                                 AcceptsTab="True"
                                                 TextChanged="ContentEditor_OnTextChanged"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Segoe UI"
                                                 FontSize="14">
                                        <FlowDocument PagePadding="0"
                                                      Foreground="{DynamicResource InkBrush}"/>
                                    </RichTextBox>
                                </Border>

                                <TextBlock Grid.Row="8" Text="Preview do resultado"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"/>
                                <Border Grid.Row="10"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Background="{DynamicResource ElevatedBrush}"
                                        Padding="12">
                                    <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                                              VerticalScrollBarVisibility="Auto"
                                                              IsToolBarVisible="False"
                                                              Background="Transparent"
                                                              Foreground="{DynamicResource InkBrush}">
                                        <FlowDocument x:Name="PreviewDocument"
                                                      PagePadding="0"
                                                      Foreground="{DynamicResource InkBrush}"/>
                                    </FlowDocumentScrollViewer>
                                </Border>

                                <Grid Grid.Row="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <Button Grid.Column="1" Content="Excluir"
                                            Style="{StaticResource DangerButton}"
                                            Click="DeleteSnippet_OnClick"/>
                                    <Button Grid.Column="3" Content="Salvar atalho"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="SaveSnippet_OnClick"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <Border x:Name="ShortcutRightDivider"
                                Grid.Column="3"
                                Background="{DynamicResource DividerBrush}"/>

                        <ScrollViewer x:Name="ShortcutVariablesPanel"
                                      Grid.Column="4"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18">
                                <TextBlock Text="Variáveis"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="Clique para inserir. Passe o mouse para ver a descrição."
                                           Margin="0,4,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"/>
                                <Expander Header="Campos e navegação" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{nome}}" Tag="{}{{nome}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Solicita um valor chamado nome antes da expansão."
                                                Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{campo|padrão}}" Tag="{}{{campo|valor padrão}}"
                                                Style="{StaticResource VariableButton}"
                                                ToolTip="Campo preenchível com um valor inicial sugerido."
                                                Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{tab}}" Tag="{}{{tab}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Avança para o próximo campo do aplicativo, como assunto → corpo."
                                                Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Data e hora" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{data}}" Tag="{}{{data}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual em dd/MM/yyyy." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data_curta}}" Tag="{}{{data_curta}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual abreviada em dd/MM/yy." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data_extensa}}" Tag="{}{{data_extensa}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data por extenso com dia da semana, mês e ano." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{hora}}" Tag="{}{{hora}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Hora atual em HH:mm." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data:+7d}}" Tag="{}{{data:+7d}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual mais 7 dias. Aceita d, m ou y e sinais + ou -."
                                                Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Partes da data" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{dia}}" Tag="{}{{dia}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Número do dia." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{dia_semana}}" Tag="{}{{dia_semana}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Dia da semana por extenso." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{dia_semana_curto}}" Tag="{}{{dia_semana_curto}}"
                                                Style="{StaticResource VariableButton}"
                                                ToolTip="Dia da semana abreviado." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes}}" Tag="{}{{mes}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Número do mês." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes_nome}}" Tag="{}{{mes_nome}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Mês por extenso." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes_curto}}" Tag="{}{{mes_curto}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Mês abreviado." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{ano}}" Tag="{}{{ano}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Ano com quatro dígitos." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{ano_curto}}" Tag="{}{{ano_curto}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Ano com dois dígitos." Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Sistema">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{usuario}}" Tag="{}{{usuario}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Nome do usuário conectado ao Windows." Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer x:Name="QuickAccentView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32,28,32,32" MaxWidth="1180" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Acento Rápido" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Digite caracteres especiais sem interromper seu fluxo."
                                           Style="{StaticResource PageDescription}"/>
                            </StackPanel>

                            <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PRÉVIA AO VIVO" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock Text="Segure A e toque na tecla de ativação para avançar"
                                                       Margin="0,4,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource ChromeBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7">
                                            <TextBlock Text="A + Espaço" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                    </Grid>
                                    <UniformGrid Columns="8">
                                        <Border x:Name="QuickAccentPreviewChoice0" Tag="0"
                                                Style="{StaticResource FeatureTile}"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="a" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="QuickAccentPreviewChoice1" Tag="1"
                                                Style="{StaticResource FeatureTile}"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="á" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="QuickAccentPreviewChoice2" Tag="2"
                                                Style="{StaticResource FeatureTile}"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="à" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="QuickAccentPreviewChoice3" Tag="3"
                                                Style="{StaticResource FeatureTile}"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="â" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="QuickAccentPreviewChoice4" Tag="4"
                                                Style="{StaticResource FeatureTile}"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="ã" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="QuickAccentPreviewChoice5" Tag="5"
                                                Style="{StaticResource FeatureTile}"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="ä" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="QuickAccentPreviewChoice6" Tag="6"
                                                Style="{StaticResource FeatureTile}"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="å" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="QuickAccentPreviewChoice7" Tag="7"
                                                Style="{StaticResource FeatureTile}" Margin="6"
                                                MouseLeftButtonDown="QuickAccentPreviewChoice_OnMouseLeftButtonDown">
                                            <TextBlock Text="æ" FontSize="31" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Text="Cada toque avança uma opção. Solte a letra para inserir o caractere destacado."
                                               Margin="0,14,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.02*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="1.18*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Como ativar" FontSize="17" FontWeight="SemiBold"/>
                                        <CheckBox x:Name="QuickAccentEnabledCheckBox"
                                                  Content="Ativar Acento Rápido"
                                                  Margin="0,14,0,10" FontWeight="SemiBold"
                                                  Click="QuickAccentSettings_OnChanged"/>
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                                        <TextBlock Text="Tecla de ativação" Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="QuickAccentActivationBox" Margin="0,6,0,14"
                                                  SelectionChanged="QuickAccentSettings_OnChanged">
                                            <ComboBoxItem Content="Espaço" Tag="Space"/>
                                            <ComboBoxItem Content="Seta esquerda" Tag="Left"/>
                                            <ComboBoxItem Content="Seta direita" Tag="Right"/>
                                        </ComboBox>
                                        <TextBlock Text="Atraso para abrir" Foreground="{DynamicResource MutedBrush}"/>
                                        <Grid Margin="0,6,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="QuickAccentDelaySlider" Minimum="100" Maximum="1000"
                                                    TickFrequency="50" ValueChanged="QuickAccentDelaySlider_OnValueChanged"/>
                                            <TextBox Grid.Column="1" x:Name="QuickAccentDelayBox"
                                                     Margin="10,0,0,0" LostFocus="QuickAccentSettings_OnChanged"/>
                                        </Grid>
                                        <TextBlock Text="Posição do painel" Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="QuickAccentPositionBox" Margin="0,6,0,8"
                                                  SelectionChanged="QuickAccentSettings_OnChanged">
                                            <ComboBoxItem Content="Centro superior" Tag="TopCenter"/>
                                            <ComboBoxItem Content="Centro da tela" Tag="Center"/>
                                            <ComboBoxItem Content="Centro inferior" Tag="BottomCenter"/>
                                        </ComboBox>
                                        <CheckBox x:Name="QuickAccentUnicodeCheckBox"
                                                  Content="Mostrar código Unicode"
                                                  Click="QuickAccentSettings_OnChanged"/>
                                        <CheckBox x:Name="QuickAccentSortCheckBox"
                                                  Content="Priorizar caracteres mais usados"
                                                  Click="QuickAccentSettings_OnChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SettingsCard}" Margin="0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Conjuntos de caracteres" FontSize="17" FontWeight="SemiBold"/>
