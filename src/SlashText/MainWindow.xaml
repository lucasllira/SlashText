<Window x:Class="SlashText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashText.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SlashDesk"
        Icon="Assets/SlashDesk.ico"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        SizeChanged="MainWindow_OnSizeChanged"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="66"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                Panel.ZIndex="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/SlashDesk.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="SlashDesk" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            ToolTip="Minimizar" Click="MinimizeWindow_OnClick"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                            ToolTip="Maximizar ou restaurar" Click="MaximizeWindow_OnClick"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                            ToolTip="Fechar" Click="CloseWindow_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource AppShellHeader}"
                Panel.ZIndex="2">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="32,0,0,0">
                <Border Style="{StaticResource BrandMark}"
                        Margin="0,0,10,0">
                    <Image Source="Assets/SlashDesk.png"
                           Width="27"
                           Height="27"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ShellPageTitle" Text="Atalhos"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock x:Name="ShellPageDescription" Text="Crie, organize e edite seus textos prontos."
                               FontSize="11"
                               Margin="0,1,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,32,0" VerticalAlignment="Center">
                <StackPanel x:Name="ShortcutHeaderActions" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="ImportSnippets_OnClick"
                            ToolTip="Importar atalhos do SlashDesk, Text Blaze ou Espanso">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Import}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Importar"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="NewSnippet_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Add}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Novo atalho"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Style="{StaticResource CompactStatusPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDot}"/>
                        <TextBlock x:Name="MonitorStatusText" Text="Iniciando monitoramento"
                                   Foreground="{DynamicResource InkBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource AppNavigationBar}">
            <Grid>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Style>
                </Grid.Resources>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="ShortcutsTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="ShortcutsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Shortcuts}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Atalhos"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickAccentTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="QuickAccentTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.QuickAccent}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Acento Rápido"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CaptureTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="CaptureTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Capture}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Captura"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatisticsTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="StatisticsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Statistics}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Estatísticas"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="SettingsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Configurações"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="AboutTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.About}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Sobre"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="WorkspaceHost" Grid.Row="3"
                Style="{StaticResource AppWorkspace}">
                <Grid>
                    <Grid x:Name="ShortcutsView">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ShortcutPrimaryRow" Height="*"/>
                            <RowDefinition x:Name="ShortcutSecondaryRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ShortcutLeftColumn" Width="280" MinWidth="220" MaxWidth="460"/>
                            <ColumnDefinition x:Name="ShortcutLeftDividerColumn" Width="16"/>
                            <ColumnDefinition x:Name="ShortcutEditorColumn" Width="*" MinWidth="520"/>
                            <ColumnDefinition x:Name="ShortcutRightDividerColumn" Width="16"/>
                            <ColumnDefinition x:Name="ShortcutRightColumn" Width="384" MinWidth="240" MaxWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="ShortcutSidebarPanel"
                              Style="{StaticResource WorkspaceSidebar}"
                              Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchBox"
                                     TextChanged="SearchBox_OnTextChanged"
                                     ToolTip="Buscar por nome, conteúdo, /atalho ou categoria"/>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="CATEGORIAS" Style="{StaticResource SidebarSectionTitle}" Margin="2,0,0,6"/>
                                <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CategoriesPanel"/>
                                </ScrollViewer>
                            </StackPanel>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="EXIBIÇÃO" Style="{StaticResource SidebarSectionTitle}" Margin="2,0,0,6"/>
                                <StackPanel x:Name="MostUsedPanel" Orientation="Horizontal">
                                    <Button x:Name="DisplayAllButton" Content="Todos"
                                            MinWidth="90" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="DisplayAll_OnClick"/>
                                    <Button x:Name="DisplayMostUsedButton" Content="Mais utilizados"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="DisplayMostUsed_OnClick"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ATALHOS" Style="{StaticResource SidebarSectionTitle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SnippetCountText" Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TertiaryBrush}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="8" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SnippetListPanel"/>
                            </ScrollViewer>
                        </Grid>

                        <GridSplitter x:Name="ShortcutLeftDivider"
                                      Grid.Column="1"
                                      Style="{StaticResource WorkspaceColumnSplitter}"
                                      ResizeBehavior="PreviousAndNext"
                                      AutomationProperties.Name="Redimensionar lista de atalhos e editor"
                                      ToolTip="Arraste para ajustar a lista. Use ←/→ em passos de 16 px, Home ou clique duplo para restaurar."
                                      PreviewKeyDown="ShortcutSplitter_OnPreviewKeyDown"
                                      MouseDoubleClick="ShortcutSplitter_OnMouseDoubleClick"
                                      DragStarted="ShortcutSplitter_OnDragStarted"
                                      DragCompleted="ShortcutSplitter_OnDragCompleted"/>

                        <ScrollViewer x:Name="ShortcutEditorPanel"
                                      Grid.Column="2"
                                      Background="{DynamicResource SurfaceBrush}"
                                      BorderBrush="{DynamicResource DividerBrush}"
                                      BorderThickness="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="190"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NameBox" TextChanged="EditorField_OnTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Comando" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TriggerBox" TextChanged="EditorField_OnTextChanged"
                                                 ToolTip="Use /atalho ou :atalho"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="CategoryBox" TextChanged="EditorField_OnTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Formato" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="FormatBox" Padding="9"
                                                  SelectedIndex="0"
                                                  SelectionChanged="FormatBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Texto simples"/>
                                            <ComboBoxItem Content="Texto formatado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="FormattingToolbar" Grid.Row="4" Visibility="Collapsed">
                                    <WrapPanel>
                                        <TextBlock Text="Texto" VerticalAlignment="Center" Width="76"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="FontFamilyBox"
                                              Width="132"
                                              MinHeight="34"
                                              Margin="0,0,6,6"
                                              ToolTip="Fonte"
                                              SelectedIndex="0"
                                              SelectionChanged="FontFamilyBox_OnSelectionChanged">
                                        <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                                        <ComboBoxItem Content="Arial" Tag="Arial"/>
                                        <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                                        <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                                        <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                                        </ComboBox>
                                        <ComboBox x:Name="FontSizeBox"
                                              Width="68"
                                              MinHeight="34"
                                              Margin="0,0,6,6"
                                              ToolTip="Tamanho da fonte"
                                              SelectedIndex="2"
                                              SelectionChanged="FontSizeBox_OnSelectionChanged">
                                        <ComboBoxItem Content="9" Tag="12"/>
                                        <ComboBoxItem Content="10" Tag="13.333"/>
                                        <ComboBoxItem Content="11" Tag="14.667"/>
                                        <ComboBoxItem Content="12" Tag="16"/>
                                        <ComboBoxItem Content="14" Tag="18.667"/>
                                        <ComboBoxItem Content="16" Tag="21.333"/>
                                        <ComboBoxItem Content="18" Tag="24"/>
                                        <ComboBoxItem Content="24" Tag="32"/>
                                        </ComboBox>
                                        <Button Content="B" FontWeight="Bold"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Negrito" Click="Bold_OnClick"/>
                                    <Button Content="I" FontStyle="Italic"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Itálico" Click="Italic_OnClick"/>
                                    <Button Content="U"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Sublinhado" Click="Underline_OnClick"/>
                                    <Button Content="Cor"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Cor do texto" Click="Color_OnClick"/>
                                        <Button Content="Marca-texto"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Cor de destaque do texto"
                                            Click="Highlight_OnClick"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Inserir" VerticalAlignment="Center" Width="76"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="Link"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Inserir hiperlink" Click="Link_OnClick"/>
                                    <Button Content="Imagem"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Adicionar imagem ao atalho" Click="Image_OnClick"/>
                                    <Button Content="• Lista"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Lista com marcadores"
                                            Click="Bullets_OnClick"/>
                                        <Button Content="1. Lista"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Lista numerada"
                                            Click="Numbering_OnClick"/>
                                        <Button Content="Tabela"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Inserir tabela"
                                            Click="Table_OnClick"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Parágrafo" VerticalAlignment="Center" Width="76"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="≡ Esq."
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Alinhar à esquerda"
                                            Click="AlignLeft_OnClick"/>
                                    <Button Content="≡ Centro"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Centralizar"
                                            Click="AlignCenter_OnClick"/>
                                    <Button Content="≡ Dir."
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Alinhar à direita"
                                            Click="AlignRight_OnClick"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Row="6"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Background="{DynamicResource InputBrush}">
                                    <RichTextBox x:Name="ContentEditor"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 CaretBrush="{DynamicResource InkBrush}"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 SelectionOpacity="0.3"
                                                 Padding="12"
                                                 AcceptsTab="True"
                                                 TextChanged="ContentEditor_OnTextChanged"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Segoe UI"
                                                 FontSize="14">
                                        <FlowDocument PagePadding="0"
                                                      Foreground="{DynamicResource InkBrush}"/>
                                    </RichTextBox>
                                </Border>

                                <TextBlock Grid.Row="8" Text="Preview do resultado"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"/>
                                <Border Grid.Row="10"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Padding="12">
                                    <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                                              VerticalScrollBarVisibility="Auto"
                                                              IsToolBarVisible="False"
                                                              Background="Transparent"
                                                              Foreground="{DynamicResource InkBrush}">
                                        <FlowDocument x:Name="PreviewDocument"
                                                      PagePadding="0"
                                                      Foreground="{DynamicResource InkBrush}"/>
                                    </FlowDocumentScrollViewer>
                                </Border>

                                <Grid Grid.Row="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <Button Grid.Column="1" Content="Excluir"
                                            Style="{StaticResource DangerButton}"
                                            Click="DeleteSnippet_OnClick"/>
                                    <Button Grid.Column="3"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="SaveSnippet_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Save}" Style="{StaticResource NavigationIcon}"/>
                                            <TextBlock Text="Salvar"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <GridSplitter x:Name="ShortcutRightDivider"
                                      Grid.Column="3"
                                      Style="{StaticResource WorkspaceColumnSplitter}"
                                      ResizeBehavior="PreviousAndNext"
                                      AutomationProperties.Name="Redimensionar editor e painel de variáveis"
                                      ToolTip="Arraste para ajustar as variáveis. Use ←/→ em passos de 16 px, Home ou clique duplo para restaurar."
                                      PreviewKeyDown="ShortcutSplitter_OnPreviewKeyDown"
                                      MouseDoubleClick="ShortcutSplitter_OnMouseDoubleClick"
                                      DragStarted="ShortcutSplitter_OnDragStarted"
                                      DragCompleted="ShortcutSplitter_OnDragCompleted"/>

                        <ScrollViewer x:Name="ShortcutVariablesPanel"
                                      Grid.Column="4"
                                      Background="{DynamicResource SurfaceBrush}"
                                      BorderBrush="{DynamicResource DividerBrush}"
                                      BorderThickness="1"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Text="Variáveis"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="Clique para inserir. Passe o mouse para ver a descrição."
                                           Margin="0,4,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"/>
                                <Expander Header="Campos e navegação" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{nome}}" Tag="{}{{nome}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Solicita um valor chamado nome antes da expansão."
                                                Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{campo|padrão}}" Tag="{}{{campo|valor padrão}}"
                                                Style="{StaticResource VariableButton}"
                                                ToolTip="Campo preenchível com um valor inicial sugerido."
                                                Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{tab}}" Tag="{}{{tab}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Avança para o próximo campo do aplicativo, como assunto → corpo."
                                                Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Data e hora" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{data}}" Tag="{}{{data}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual em dd/MM/yyyy." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data_curta}}" Tag="{}{{data_curta}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual abreviada em dd/MM/yy." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data_extensa}}" Tag="{}{{data_extensa}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data por extenso com dia da semana, mês e ano." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{hora}}" Tag="{}{{hora}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Hora atual em HH:mm." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{data:+7d}}" Tag="{}{{data:+7d}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Data atual mais 7 dias. Aceita d, m ou y e sinais + ou -."
                                                Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Partes da data" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{dia}}" Tag="{}{{dia}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Número do dia." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{dia_semana}}" Tag="{}{{dia_semana}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Dia da semana por extenso." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{dia_semana_curto}}" Tag="{}{{dia_semana_curto}}"
                                                Style="{StaticResource VariableButton}"
                                                ToolTip="Dia da semana abreviado." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes}}" Tag="{}{{mes}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Número do mês." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes_nome}}" Tag="{}{{mes_nome}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Mês por extenso." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{mes_curto}}" Tag="{}{{mes_curto}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Mês abreviado." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{ano}}" Tag="{}{{ano}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Ano com quatro dígitos." Click="VariableChip_OnClick"/>
                                        <Button Content="{}{{ano_curto}}" Tag="{}{{ano_curto}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Ano com dois dígitos." Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Sistema">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="{}{{usuario}}" Tag="{}{{usuario}}" Style="{StaticResource VariableButton}"
                                                ToolTip="Nome do usuário conectado ao Windows." Click="VariableChip_OnClick"/>
                                    </StackPanel>
                                </Expander>
                                <Border Style="{StaticResource SubtlePanel}" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Ajuda rápida" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="Clique em uma variável para inseri-la no cursor. Campos preenchíveis serão solicitados antes da expansão."
                                                   Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Armazenamento local · snippets.md"
                                                   Margin="0,8,0,0" FontSize="11"
                                                   Foreground="{DynamicResource AccentStrongBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer x:Name="QuickAccentView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="1180" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
