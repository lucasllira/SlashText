<Window x:Class="SlashText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashText.Views"
        Title="SlashDesk"
        Icon="Assets/SlashDesk.ico"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        SizeChanged="MainWindow_OnSizeChanged"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppShellHeader}"
                Panel.ZIndex="2">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                <Border Style="{StaticResource BrandMark}"
                        Margin="0,0,10,0">
                    <Image Source="Assets/SlashDesk.png"
                           Width="27"
                           Height="27"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SlashDesk"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="Produtividade local para Windows"
                               FontSize="11"
                               Margin="0,1,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                    Style="{StaticResource CompactStatusPill}"
                    Margin="16,0,20,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource StatusDot}"/>
                    <TextBlock x:Name="MonitorStatusText"
                               Text="Iniciando monitoramento"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="12"/>
                </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource AppNavigationBar}">
            <Grid>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Style>
                </Grid.Resources>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="ShortcutsTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="ShortcutsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Shortcuts}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Atalhos"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickAccentTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="QuickAccentTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.QuickAccent}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Acento RÃ¡pido"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CaptureTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="CaptureTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Capture}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Captura"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatisticsTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="StatisticsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Statistics}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="EstatÃ­sticas"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="SettingsTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="ConfiguraÃ§Ãµes"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutTabButton"
                            Style="{StaticResource AppNavigationButton}"
                            Click="AboutTab_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.About}" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Text="Sobre"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource AppWorkspace}">
                <Grid>
                    <Grid x:Name="ShortcutsView">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ShortcutPrimaryRow" Height="*"/>
                            <RowDefinition x:Name="ShortcutSecondaryRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ShortcutLeftColumn" Width="260"/>
                            <ColumnDefinition x:Name="ShortcutLeftDividerColumn" Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ShortcutRightDividerColumn" Width="1"/>
                            <ColumnDefinition x:Name="ShortcutRightColumn" Width="260"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="ShortcutSidebarPanel"
                              Style="{StaticResource WorkspaceSidebar}"
                              Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Atalhos"
                                           Style="{StaticResource PageHeading}"/>
                                <TextBlock Text="Encontre e organize seus textos."
                                           Style="{StaticResource PageSupportingText}"/>
                            </StackPanel>
                            <TextBox x:Name="SearchBox"
                                     Grid.Row="2"
                                     TextChanged="SearchBox_OnTextChanged"
                                     ToolTip="Buscar por nome, comando ou categoria"/>
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CategoriesPanel"/>
                            </ScrollViewer>
                            <Border Grid.Row="6"
                                    Style="{StaticResource SubtlePanel}"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Mais usados" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"/>
                                    <StackPanel x:Name="MostUsedPanel" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Click="ImportSnippets_OnClick"
                                        ToolTip="Importar atalhos do SlashDesk, Text Blaze ou Espanso">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Import}" Style="{StaticResource NavigationIcon}"/>
                                        <TextBlock Text="Importar"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="NewSnippet_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Add}" Style="{StaticResource NavigationIcon}"/>
                                        <TextBlock Text="Novo atalho"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <Border x:Name="ShortcutLeftDivider"
                                Grid.Column="1"
                                Background="{DynamicResource DividerBrush}"/>

                        <ScrollViewer x:Name="ShortcutEditorPanel"
                                      Grid.Column="2"
                                      Background="{DynamicResource SurfaceBrush}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="190"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NameBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Comando" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TriggerBox"
                                                 ToolTip="Use /atalho ou :atalho"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="CategoryBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Formato" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="FormatBox" Padding="9"
