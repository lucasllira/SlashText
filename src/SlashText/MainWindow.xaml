                                                    <ComboBoxItem Content="JPEG" Tag="JPEG"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Qualidade" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBox x:Name="CaptureQualityBox" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="CaptureClipboardCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Copiar após capturar" Margin="0,14,0,5"/>
                                        <CheckBox x:Name="CaptureAutoSaveCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Salvar automaticamente" Margin="0,5"/>
                                        <CheckBox x:Name="CaptureCursorCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Incluir cursor na imagem" Margin="0,5"/>
                                        <CheckBox x:Name="CaptureEditorCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Abrir editor para monitor e janela" Margin="0,5"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Atraso" Foreground="{DynamicResource MutedBrush}"/>
                                                <ComboBox x:Name="CaptureDelayBox" Margin="0,5,0,0">
                                                    <ComboBoxItem Content="Sem atraso" Tag="0"/>
                                                    <ComboBoxItem Content="3 segundos" Tag="3"/>
                                                    <ComboBoxItem Content="5 segundos" Tag="5"/>
                                                    <ComboBoxItem Content="10 segundos" Tag="10"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Limpar histórico após" Foreground="{DynamicResource MutedBrush}"/>
                                                <ComboBox x:Name="CaptureRetentionBox" Margin="0,5,0,0">
                                                    <ComboBoxItem Content="30 dias" Tag="30"/>
                                                    <ComboBoxItem Content="90 dias" Tag="90"/>
                                                    <ComboBoxItem Content="180 dias" Tag="180"/>
                                                    <ComboBoxItem Content="Nunca" Tag="0"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="Salvar regra" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                                Click="SaveCaptureSettings_OnClick"/>
                                        <TextBlock x:Name="CaptureShortcutStatusText"
                                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Clique em um atalho acima e pressione Print Screen, F10, roda ou botão do mouse."
                                                   Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="8" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Capturas recentes"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="sem upload  ·  sua privacidade é prioridade"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="Filtro" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="CaptureHistoryFilterBox"
                                                  Width="180"
                                                  Margin="10,0,0,0"
                                                  SelectionChanged="CaptureHistoryFilter_OnChanged">
                                            <ComboBoxItem Content="Todos" Tag="all"/>
                                            <ComboBoxItem Content="Monitor" Tag="monitor"/>
                                            <ComboBoxItem Content="Região" Tag="regiao"/>
                                            <ComboBoxItem Content="Janela" Tag="janela"/>
                                            <ComboBoxItem Content="Vídeo MP4" Tag="video"/>
                                            <ComboBoxItem Content="GIF" Tag="gif"/>
                                        </ComboBox>
                                        <Button Content="Limpar agora"
                                                Margin="10,0,0,0"
                                                Click="CleanCaptureHistory_OnClick"/>
                                        <TextBlock x:Name="CaptureHistoryStatusText"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="CaptureHistoryPanel" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="StatisticsView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="1180" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Estatísticas" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Veja quanto tempo o SlashDesk devolveu ao seu dia."
                                           Style="{StaticResource PageDescription}"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="2" Columns="4">
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Expansões de texto"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="TotalExpansionsText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Caracteres poupados"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="CharactersSavedText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Acentos inseridos"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="QuickAccentTotalText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Capturas realizadas"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="CaptureTotalText"
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="0.75*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Atalhos mais usados"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Ranking por quantidade de expansões"
                                                   Margin="0,4,0,12"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <StackPanel x:Name="StatisticsRankingPanel"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Atividade por recurso"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <Grid Margin="0,14,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Atalhos ativos" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="UsedSnippetsText" Style="{StaticResource MetricValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="Acento favorito" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="QuickAccentFavoriteText" Style="{StaticResource MetricValue}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Capturas por tipo" Foreground="{DynamicResource MutedBrush}"/>
                                        <Grid Margin="0,9,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Região" Margin="0,3"/>
                                                <TextBlock Text="Monitor" Margin="0,3"/>
                                                <TextBlock Text="Janela" Margin="0,3"/>
                                                <TextBlock Text="GIF" Margin="0,3"/>
                                                <TextBlock Text="MP4" Margin="0,3"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="CaptureRegionTotalText" Margin="0,3" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="CaptureMonitorTotalText" Margin="0,3" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="CaptureWindowTotalText" Margin="0,3" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="CaptureGifTotalText" Margin="0,3" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="CaptureMp4TotalText" Margin="0,3" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Caracteres mais inseridos" Foreground="{DynamicResource MutedBrush}"/>
                                        <WrapPanel x:Name="QuickAccentCharactersPanel"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="6" Style="{StaticResource SettingsCard}" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tempo economizado" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="TimeSavedText" Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" Margin="18,0"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Média por expansão" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="AverageCharactersText" Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" Margin="18,0"/>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Privacidade" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Somente contagens locais" Margin="0,9,0,0"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="1060" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Configurações" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Preferências do aplicativo, aparência e funcionamento no Windows."
                                           Style="{StaticResource PageDescription}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Aparência"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Tema do SlashDesk"
                                                   Margin="0,18,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="ThemeBox"
                                                  Margin="0,7,0,0"
                                                  SelectionChanged="ThemeBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Seguir o Windows" Tag="System"/>
                                            <ComboBoxItem Content="Claro" Tag="Light"/>
                                            <ComboBoxItem Content="Escuro" Tag="Dark"/>
                                        </ComboBox>
                                        <TextBlock Text="A mudança é aplicada em todas as telas, diálogos e menus."
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Comportamento"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <CheckBox x:Name="CloseToTrayCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Manter na bandeja ao fechar"
                                                  Margin="0,16,0,7"
                                                  Click="Settings_OnClick"/>
                                        <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Iniciar com o Windows"
                                                  Click="Settings_OnClick"/>
                                        <CheckBox x:Name="ShowSuggestionsCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Mostrar sugestões ao digitar / ou :"
                                                  Click="Settings_OnClick"/>
                                        <CheckBox x:Name="CheckUpdatesCheckBox" Style="{StaticResource ToggleSwitch}"
                                                  Content="Verificar atualizações automaticamente"
                                                  Click="Settings_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Importar atalhos"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Migre seus atalhos sem recriar tudo. O SlashDesk converte formatos conhecidos e informa o que precisa de revisão."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Origem"
                                                   Margin="0,16,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox x:Name="ImportSourceBox"
                                                  SelectedIndex="0"
                                                  Margin="0,7,0,0">
                                            <ComboBoxItem Content="SlashDesk (snippets.md)" Tag="SlashDesk"/>
                                            <ComboBoxItem Content="Text Blaze (JSON)" Tag="TextBlaze"/>
                                            <ComboBoxItem Content="Espanso (YAML)" Tag="Espanso"/>
                                        </ComboBox>
                                        <Button Content="Selecionar arquivo e importar"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Click="ImportSnippets_OnClick"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Antes de alterar o snippets.md, o estado atual é salvo automaticamente."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Backup e restauração"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Um ZIP local é criado por dia. O SlashDesk mantém as sete cópias mais recentes com atalhos, preferências, estatísticas e histórico."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="BackupSummaryText"
                                                   Text="Carregando backups..."
                                                   Margin="0,12,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="Criar agora"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,8,8"
                                                    Click="CreateBackup_OnClick"/>
                                            <Button Content="Restaurar ZIP"
                                                    Margin="0,0,8,8"
                                                    Click="RestoreBackup_OnClick"/>
                                            <Button Content="Abrir pasta"
                                                    Margin="0,0,0,8"
                                                    Click="OpenBackupFolder_OnClick"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="BackupLocationText"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Os backups permanecem na origem de dados selecionada. Nenhum arquivo é enviado para a nuvem."
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="6" Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource StandaloneIcon}" Margin="0,0,9,0"/>
                                            <TextBlock Text="Atualizações" FontSize="17" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SettingsVersionText" Margin="0,14,0,0"
                                                   FontWeight="SemiBold" Text="Versão atual"/>
                                        <TextBlock Text="Canal estável · GitHub Releases oficiais"
                                                   Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="SettingsLastUpdateCheckText"
                                                   Text="Última verificação: ainda não verificado"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="SettingsLastUpdateResultText"
                                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Text="Resultado: ainda não verificado"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button x:Name="SettingsCheckUpdatesButton"
                                                Content="Verificar agora"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,12,0,0"
                                                Click="CheckUpdates_OnClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24" MaxWidth="980" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SettingsCard}"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="Assets/SlashDesk.png"
                                           Width="104"
                                           Height="104"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="SlashDesk"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="32"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Texto, acentos e capturas locais para Windows"
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="Versão atual · Licença MIT · código aberto"
                                                   Margin="0,12,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Feito para reduzir trabalho repetitivo"
                                           Style="{StaticResource PageTitle}"
                                           FontSize="22"/>
                                <TextBlock Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Text="Crie atalhos reutilizáveis, digite acentos em teclados internacionais e capture monitor, região ou janela com organização automática."/>
                            </StackPanel>

                            <UniformGrid Grid.Row="4" Columns="3">
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="Principais recursos"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Atalhos / e :, variáveis, texto formatado, Acento Rápido, monitor ativo, região, janela, atalhos globais e regras de pasta."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource StandaloneIcon}"
                                              Width="28" Height="28" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Privacidade" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Seus atalhos, estatísticas, capturas e histórico permanecem na origem de dados escolhida."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Projeto aberto"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Código disponível no GitHub para estudo, auditoria e colaboração sob a licença MIT."/>
                                        <TextBlock x:Name="UpdateChannelText"
                                                   Margin="0,12,0,0"
                                                   Text="Canal: estável"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="LastUpdateCheckText"
                                                   Margin="0,4,0,0"
                                                   Text="Última verificação: ainda não verificado"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="LastUpdateResultText"
                                                   Margin="0,4,0,0"
                                                   Text="Resultado: ainda não verificado"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="Abrir projeto no GitHub"
                                                HorizontalAlignment="Left"
                                                Margin="0,14,0,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="OpenGitHub_OnClick"/>
                                        <Button x:Name="CheckUpdatesButton"
                                                Content="Verificar agora"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Click="CheckUpdates_OnClick"/>
                                        <Button x:Name="ReleaseNotesButton"
                                                Content="Visualizar notas da versão"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Visibility="Collapsed"
                                                Click="ReleaseNotes_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource StatusDot}"/>
                    <TextBlock x:Name="ShellStatusText" Text="Monitoramento ativo"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <TextBlock x:Name="ShellCollectionStatusText" Grid.Column="1" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TertiaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
