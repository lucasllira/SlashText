                                        <TextBlock Text="Variáveis: {date}, {time}, {type} e {app}"
                                                   Margin="0,5,0,10" FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
