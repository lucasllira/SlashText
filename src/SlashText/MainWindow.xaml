                                                Style="{StaticResource PrimaryButton}"
                                                Click="CaptureActiveMonitor_OnClick"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Region}" Style="{StaticResource StandaloneIcon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Região" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="Selecione, anote e conclua sem trocar de janela."
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <views:ShortcutRecorderBox x:Name="CaptureRegionShortcutBox"
                                                                   Margin="0,10,0,10"/>
                                        <Button Content="Selecionar região"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="CaptureRegion_OnClick"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Window}" Style="{StaticResource StandaloneIcon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Janela" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="Capture somente a janela sob o cursor."
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <views:ShortcutRecorderBox x:Name="CaptureWindowShortcutBox"
                                                                   Margin="0,10,0,10"/>
                                        <Button Content="Capturar janela"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="CaptureWindow_OnClick"/>
                                        <Button Content="Captura com rolagem"
                                                Margin="0,8,0,0"
                                                ToolTip="Captura vertical experimental da janela sob o cursor"
                                                Click="CaptureScrolling_OnClick"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Region}" Style="{StaticResource StandaloneIcon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Gravar GIF" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="Região real, preview e salvamento local."
                                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <Button Content="Iniciar GIF" Margin="0,10,0,0"
                                                Click="StartGifRecording_OnClick"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Record}" Style="{StaticResource StandaloneIcon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Gravar vídeo" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="MP4 H.264 com pausa e retomada."
                                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
