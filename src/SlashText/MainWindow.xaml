                                                <Button Content="Todos" Style="{StaticResource ToolbarButton}" Margin="0"
                                                        Click="QuickAccentSelectAll_OnClick"/>
                                            </StackPanel>
                                        </Grid>
                                        <UniformGrid Columns="2" Margin="0,14,0,8">
                                            <CheckBox x:Name="QuickAccentPortugueseCheckBox" Content="Português (Brasil)"
