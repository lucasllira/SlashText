                                                  Content="Priorizar caracteres mais usados"
                                                  Click="QuickAccentSettings_OnChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SettingsCard}" Margin="0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Conjuntos de caracteres" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="QuickAccentSetSummaryText" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
