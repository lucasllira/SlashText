                                                Margin="0,10,0,0" Click="StartMp4Recording_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="4" Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Gravação local" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="MP4 H.264 e GIF sem upload e sem FFmpeg instalado."
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource CompactStatusPill}">
                                            <TextBlock Text="Media Foundation"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SubtlePanel}">
                                            <StackPanel>
                                                <TextBlock Text="Vídeo MP4" Style="{StaticResource FieldLabel}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Destino" Foreground="{DynamicResource MutedBrush}"/>
                                                        <ComboBox x:Name="RecordingTargetBox" Margin="0,5,0,0">
