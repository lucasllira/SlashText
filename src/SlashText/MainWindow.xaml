                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="Código disponível no GitHub para estudo, auditoria e colaboração sob a licença MIT."/>
                                        <Button Content="Abrir projeto no GitHub"
                                                HorizontalAlignment="Left"
                                                Margin="0,14,0,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="OpenGitHub_OnClick"/>
                                        <Button Content="Verificar atualizações"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Click="CheckUpdates_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
        </Border>
    </Grid>
</Window>
