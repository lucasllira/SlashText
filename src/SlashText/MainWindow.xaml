                                        <Ellipse Style="{StaticResource StatusDot}"/>
                                        <TextBlock Text="Captura pronta" Foreground="{DynamicResource InkBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <UniformGrid Grid.Row="2" Columns="5">
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Monitor}" Style="{StaticResource StandaloneIcon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Monitor" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="Capture a tela inteira do monitor ativo."
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <views:ShortcutRecorderBox x:Name="CaptureMonitorShortcutBox"
                                                                   Margin="0,10,0,10"/>
