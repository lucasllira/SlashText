                                                            <ComboBoxItem Content="Região" Tag="Region"/>
                                                            <ComboBoxItem Content="Janela sob o cursor" Tag="Window"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="FPS" Foreground="{DynamicResource MutedBrush}"/>
                                                        <ComboBox x:Name="RecordingFpsBox" Margin="0,5,0,0">
                                                            <ComboBoxItem Content="24" Tag="24"/>
                                                            <ComboBoxItem Content="30" Tag="30"/>
                                                            <ComboBoxItem Content="60" Tag="60"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Qualidade" Foreground="{DynamicResource MutedBrush}"/>
                                                        <ComboBox x:Name="RecordingQualityBox"
                                                                  Margin="0,5,0,0"
                                                                  SelectionChanged="RecordingPreset_OnChanged"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="RecordingQualityDescriptionText"
                                                           Margin="0,8,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <CheckBox x:Name="RecordingCursorCheckBox"
                                                          Content="Mostrar cursor na gravação"
                                                          Margin="0,12,0,0"/>
                                                <Button x:Name="StartMp4RecordingButton"
                                                        Content="Iniciar gravação MP4"
                                                        Style="{StaticResource PrimaryButton}"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,12,0,0"
                                                        Click="StartMp4Recording_OnClick"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SubtlePanel}">
                                            <StackPanel>
                                                <TextBlock Text="GIF animado" Style="{StaticResource FieldLabel}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="FPS" Foreground="{DynamicResource MutedBrush}"/>
                                                        <ComboBox x:Name="GifFpsBox"
                                                                  Margin="0,5,0,0"
                                                                  IsEditable="False"
                                                                  SelectionChanged="RecordingPreset_OnChanged"/>
                                                        <TextBlock x:Name="GifFpsDescriptionText"
                                                                   Margin="0,6,0,0"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Qualidade" Foreground="{DynamicResource MutedBrush}"/>
                                                        <ComboBox x:Name="GifQualityBox"
                                                                  Margin="0,5,0,0"
                                                                  IsEditable="False"
                                                                  SelectionChanged="RecordingPreset_OnChanged"/>
                                                        <TextBlock x:Name="GifQualityDescriptionText"
                                                                   Margin="0,6,0,0"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="A região define as dimensões do GIF. A gravação continua até pausar ou finalizar; a prévia aparece antes de salvar."
                                                           Margin="0,12,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <Button x:Name="StartGifRecordingButton"
                                                        Content="Gravar GIF de região"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,12,0,0"
                                                        Click="StartGifRecording_OnClick"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.28*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="0.92*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Pré-visualização rápida" FontSize="17" FontWeight="SemiBold"/>
